  "license": "MIT",
  "scope": "client, characteristic and service code only; no CLI, discovery/mDNS or pairings administration",
  "changes": [
    "Guard encrypted pair-verify field before slicing authentication tag",
    "Bound all response bodies to 1MiB",
    "Reject HTTP redirects",
    "Reuse existing hc pairing-transcript patch, do not copy hc",
    "Expose valid-values discovery metadata; refuse unadvertised command enum options in driver",
    "Use net.JoinHostPort for explicit IPv6 endpoints",
    "Suppress raw accessory JSON in decoding errors",
    "Admit pair-verify responses only in the authenticated M1/M2/M3/M4 phase order; require a complete session and non-nil request readers"
  ],
