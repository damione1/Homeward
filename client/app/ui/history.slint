import { KitTheme, KitThemes, KitTextField, KitWrap, FieldAccess, NavigationStep, ButtonIntent } from "@kit";
import { ProIdentityButton, ProChart, ProChartPhase, ProChartSeries, ProChartRangeGesture } from "@kit-pro";
export enum HistoryStatistic { observation, minimum, maximum, mean, contribution }
export struct HistoryPresentation {
    generation: int, phase: ProChartPhase, notice: string, description: string,
    state-label: string, unit: string, inspection: string, group-label: string,
    series: [ProChartSeries], image: image, source-width: int, source-height: int,
    x-start: string, x-end: string, y-top: string, y-bottom: string,
    cursor-visible: bool, cursor: float, range-visible: bool, range-start: float, range-end: float,
}
export component HomewardHistory inherits Rectangle {
    in property <KitTheme> theme: KitThemes.light;
    in property <HistoryPresentation> presentation;
    in property <bool> interactive;
    in property <bool> suspended;
    private property <bool> live: root.interactive && !root.suspended;
    in-out property <string> start;
    in-out property <string> end;
    in-out property <HistoryStatistic> statistic;
    callback apply(string,string,HistoryStatistic);
    callback draft-changed();
    callback choose-statistic(HistoryStatistic);
    callback group(NavigationStep);
    callback inspect(int,float);
    callback navigate(int,NavigationStep,bool);
    callback interval(int,ProChartRangeGesture,float);
    callback viewport(length,length,color,color);
    min-height: body.min-height; preferred-height: body.preferred-height;
    min-width: 240px;
    changed theme => { root.viewport(chart.plot-width,chart.plot-height,root.theme.canvas,root.theme.accent); }
    body := VerticalLayout {
        spacing: 12px;
        KitTextField { theme: root.theme; label: "Start UTC (RFC3339)"; text <=> root.start; access: !root.interactive ? FieldAccess.disabled : root.suspended ? FieldAccess.read-only : FieldAccess.editable; edited(text) => { if (root.live) { root.draft-changed(); } } }
        KitTextField { theme: root.theme; label: "End UTC Exclusive (RFC3339)"; text <=> root.end; access: !root.interactive ? FieldAccess.disabled : root.suspended ? FieldAccess.read-only : FieldAccess.editable; edited(text) => { if (root.live) { root.draft-changed(); } } }
        KitWrap {
            ProIdentityButton { theme: root.theme; text: "Observations"; intent: root.statistic == HistoryStatistic.observation ? ButtonIntent.primary : ButtonIntent.secondary; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.choose-statistic(HistoryStatistic.observation); } } }
            ProIdentityButton { theme: root.theme; text: "Hourly Average"; intent: root.statistic == HistoryStatistic.mean ? ButtonIntent.primary : ButtonIntent.secondary; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.choose-statistic(HistoryStatistic.mean); } } }
            ProIdentityButton { theme: root.theme; text: "Minimum"; intent: root.statistic == HistoryStatistic.minimum ? ButtonIntent.primary : ButtonIntent.secondary; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.choose-statistic(HistoryStatistic.minimum); } } }
            ProIdentityButton { theme: root.theme; text: "Maximum"; intent: root.statistic == HistoryStatistic.maximum ? ButtonIntent.primary : ButtonIntent.secondary; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.choose-statistic(HistoryStatistic.maximum); } } }
            ProIdentityButton { theme: root.theme; text: "Contribution"; intent: root.statistic == HistoryStatistic.contribution ? ButtonIntent.primary : ButtonIntent.secondary; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.choose-statistic(HistoryStatistic.contribution); } } }
            ProIdentityButton { theme: root.theme; text: "Show / Refresh"; disabled: !root.interactive; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.apply(root.start,root.end,root.statistic); } } }
        }
        Text { text: root.presentation.group-label; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
        KitWrap {
            ProIdentityButton { theme: root.theme; text: "Previous Group"; disabled: !root.interactive || root.presentation.series.length == 0; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.group(NavigationStep.previous); } } }
            ProIdentityButton { theme: root.theme; text: "Next Group"; disabled: !root.interactive || root.presentation.series.length == 0; generation: root.presentation.generation; activation-enabled: root.live; accessible-enabled: root.live; trigger(t,g) => { if (root.live) { root.group(NavigationStep.next); } } }
        }
        chart := ProChart {
            theme: root.theme; generation: root.presentation.generation; phase: root.presentation.phase; interactive: root.interactive; inspection-enabled: !root.suspended;
            title: "History · server usage and costs";
            notice: root.presentation.notice; description: root.presentation.description; unit: root.presentation.unit;
            state-label: root.presentation.state-label;
            series: root.presentation.series; plot-image: root.presentation.image;
            source-width: root.presentation.source-width; source-height: root.presentation.source-height;
            x-start: root.presentation.x-start; x-end: root.presentation.x-end;
            y-top: root.presentation.y-top; y-bottom: root.presentation.y-bottom;
            inspection: root.presentation.inspection;
            cursor-visible: root.presentation.cursor-visible; cursor-position: root.presentation.cursor;
            range-visible: root.presentation.range-visible; range-start: root.presentation.range-start; range-end: root.presentation.range-end;
            coverage-label: "Logical coverage described above · gaps without UTC bounds cannot be placed on the axis";
            keyboard-help: "Arrows: each original observation, including simultaneous ones · Home/End · Shift: select · Escape: cancel";
            inspect(g,x) => { root.inspect(g,x); }
            navigate(g,step,extend) => { root.navigate(g,step,extend); }
            interval(g,gesture,x) => { root.interval(g,gesture,x); }
            viewport-changed(w,h) => { root.viewport(w,h,root.theme.canvas,root.theme.accent); }
        }
    }
}
