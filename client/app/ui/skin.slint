import { KitTheme, KitThemes, ElevationLevel } from "@kit";
import { InterFont } from "@kit-fonts/inter.slint";

// Measured from the Homeward reference. Content uses opaque surfaces; the
// independently maintained dark palette preserves the same semantic roles.
// Wells (`surface-inset`) are the only grey inside a surface; secondary
// controls rest borderless on the control fill; selection marks (checks,
// radios, switches) take the success green rather than the action accent.
export global HomewardSkin {
    public pure function theme(dark: bool, opaque: bool, scale: float, reduced: bool) -> KitTheme {
        let base = dark ? KitThemes.dark : KitThemes.light;
        return {
            canvas: dark ? #0f1013 : #f3f4f6,
            surface: dark ? (opaque ? #1a1b20 : #1a1b20f5) : (opaque ? #ffffff : #fffffff5),
            surface-raised: dark ? #22242a : #f7f7f9,
            surface-inset: dark ? #22242a : #f7f7f9,
            text-primary: dark ? #f2f3f5 : #17181c,
            text-secondary: dark ? #a3a7b0 : #5e626b,
            placeholder: dark ? #a3a7b0 : #69707c,
            accent: dark ? #8b82f0 : #5a4fcf,
            on-accent: dark ? #0f1013 : #ffffff,
            accent-hover: dark ? #9d95f3 : #4b3fb8,
            accent-pressed: dark ? #7a70e0 : #3d319c,
            accent-subtle: dark ? #2a2650 : #eceafb,
            selection: dark ? #3a3570 : #dedaf8,
            on-selection: dark ? #ffffff : #2f2690,
            danger: dark ? #f2a0a0 : #b42332,
            on-danger: base.on-danger, danger-hover: base.danger-hover, danger-pressed: base.danger-pressed,
            danger-subtle: dark ? #3a1c1f : #fce5e8,
            success: dark ? #7fd3a8 : #1d6b49,
            on-success: base.on-success, success-hover: base.success-hover, success-pressed: base.success-pressed,
            success-subtle: dark ? #173025 : #dff3e9,
            warning: dark ? #ebcb6b : #7a5600,
            on-warning: base.on-warning, warning-hover: base.warning-hover, warning-pressed: base.warning-pressed,
            warning-subtle: dark ? #352d14 : #fcf1cf,
            information: dark ? #8cc2f0 : #1f5e99,
            on-information: base.on-information, information-hover: base.information-hover,
            information-pressed: base.information-pressed,
            information-subtle: dark ? #172a3b : #e0eefa,
            border-subtle: dark ? #2c2e35 : #f0f1f4,
            border-strong: dark ? #818797 : #89909b,
            control-fill: dark ? #22242a : #f3f4f6,
            control-border: transparent,
            choice-fill: dark ? #7fd3a8 : #1d6b49,
            on-choice-fill: dark ? #0f1013 : #ffffff,
            hover: dark ? #22242a : #eceef3,
            pressed: dark ? #2c2e35 : #e1e4ec,
            disabled-fill: dark ? #22242a : #edeef2,
            disabled-text: dark ? #a2a8b6 : #69707c,
            scrim: #17181c47,
            shape: { radius-control: 14px, radius-container: 22px, radius-overlay: 30px,
                radius-pill: base.shape.radius-pill, border-width: 1px,
                border-width-strong: 1px, icon-stroke: 1.75 },
            // e1 cards, e2 popups and a flat active card; the dark palette
            // doubles every alpha so the shadows survive the darker canvas.
            elevation: {
                control: ElevationLevel.xs, container: ElevationLevel.sm,
                overlay: ElevationLevel.lg, popover: ElevationLevel.md,
                xs: { key: { offset-y: 1px, blur: 2px, spread: 0px, color: dark ? #10121b1a : #10121b0d },
                    ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } },
                sm: { key: { offset-y: 8px, blur: 24px, spread: 0px, color: dark ? #10121b1f : #10121b0f },
                    ambient: { offset-y: 1px, blur: 2px, spread: 0px, color: dark ? #10121b14 : #10121b0a } },
                md: { key: { offset-y: 12px, blur: 32px, spread: 0px, color: dark ? #10121b3d : #10121b1f },
                    ambient: { offset-y: 1px, blur: 2px, spread: 0px, color: dark ? #10121b1f : #10121b0f } },
                lg: { key: { offset-y: 24px, blur: 64px, spread: 0px, color: dark ? #10121b70 : #10121b38 },
                    ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } },
                xl: { key: { offset-y: 24px, blur: 64px, spread: 0px, color: dark ? #10121b70 : #10121b38 },
                    ambient: { offset-y: 0px, blur: 0px, spread: 0px, color: transparent } },
            },
            focus: { style: base.focus.style, width: base.focus.width,
                offset: base.focus.offset, color: dark ? #8b82f0 : #5a4fcf,
                invalid-color: base.focus.invalid-color },
            typography: {
                family: InterFont.family, family-monospace: base.typography.family-monospace,
                weight-regular: base.typography.weight-regular, weight-medium: base.typography.weight-medium,
                weight-semibold: base.typography.weight-semibold, weight-bold: base.typography.weight-bold,
                size-caption: base.typography.size-caption, size-control: base.typography.size-control,
                size-body: 16px, size-subtitle: base.typography.size-subtitle,
                size-title: base.typography.size-title, size-display: 44px,
                line-height-control: base.typography.line-height-control,
            },
            spacing: { unit: 4px, compact: base.spacing.compact,
                medium: base.spacing.medium,
                comfortable: { height: 48px, padding-inline: 16px, padding-block: 12px } },
            motion: base.motion, icons: base.icons, geometry: base.geometry,
            reduced-motion: reduced, text-scale: scale, direction: base.direction
        };
    }
}
