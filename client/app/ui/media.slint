import { KitTheme, CloseReason } from "@kit";
import { ProDetailTool, ProIdentityButton, ProMediaPanel, ProMediaGroup, ProMediaPresentation, ProMediaAction, ProMediaOperation, ProMediaOption, ProMediaOptionKind, ProDeviceValue, ProValueIntent, ProArtworkState } from "@kit-pro";

// Product composition only. Content, capabilities, privacy and exact action
// targets are supplied by the native owner; the Pro owns reusable controls.
export component HomewardMedia inherits VerticalLayout {
    in property <KitTheme> theme;
    in property <length> minimum-panel-height;
    in property <string> title;
    in property <int> generation;
    in property <bool> interactive;
    in property <bool> suspended;
    in property <bool> editable;
    in property <bool> has-data;
    in property <ProMediaPresentation> media;
    in property <bool> progress-known;
    in property <float> progress;
    in property <string> position-label;
    in property <string> duration-label;
    in property <[ProMediaAction]> actions;
    in property <[ProMediaOption]> options;
    in property <[ProDeviceValue]> values;
    in property <string> group-title;
    in property <string> coordinator;
    in property <[string]> members;
    in property <string> notice;
    in property <int> artwork-remaining-ms;
    in property <[ProDetailTool]> tools;
    callback tool-requested(int);
    callback dismiss(CloseReason);
    callback operation(int,int,ProMediaOperation);
    callback option(int,int,ProMediaOptionKind,int);
    callback edit(int,int,int,ProValueIntent);
    callback reload(int);
    callback expire-artwork(int);
    min-width: 0px;
    spacing: 12px;
    if root.has-data: ProMediaPanel {
        theme: root.theme; media: root.media; actions: root.actions; options: root.options; values: root.values;
        min-height: root.minimum-panel-height;
        title: root.title; tools: root.tools;
        tool-requested(token) => {
            if (token == root.generation) { if (root.interactive && !root.suspended) { root.reload(root.generation); } }
            else { root.tool-requested(token); }
        }
        interactive: root.interactive; commands-enabled: root.editable;
        can-volume: false; can-mute: false;
        dismiss(reason) => { root.dismiss(reason); }
        progress-known: root.progress-known; progress: root.progress;
        position-label: root.position-label; duration-label: root.duration-label;
        operation-requested(token,generation,operation) => { root.operation(token,generation,operation); }
        option-requested(token,generation,kind,option) => { root.option(token,generation,kind,option); }
        value-edited(token,generation,field,intent) => { root.edit(token,generation,field,intent); }
    }
    if root.has-data && root.group-title != "": ProMediaGroup {
        theme: root.theme; title: root.group-title; coordinator: root.coordinator; members: root.members;
    }
    if root.notice != "": Text { text: root.notice; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: char-wrap; }
    // Expiry does not wait for an in-flight network read or a polling interval.
    Timer {
        running: root.has-data && root.media.artwork-state == ProArtworkState.ready;
        interval: max(1,root.artwork-remaining-ms) * 1ms;
        triggered => { root.expire-artwork(root.generation); }
    }
}
