import { KitTheme, CloseReason, RangeThumb, Tone, TypographyRole } from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";
import { ProDetailTool, ProIdentityButton, ProMediaPanel, ProMediaMember, ProMediaPresentation, ProMediaAction, ProMediaOperation, ProMediaOption, ProMediaOptionKind, ProDeviceValue, ProValueIntent, ProArtworkState, ProSwitchState } from "@kit-pro";

// The player's volume as the host last published it. `field` is the host's
// value token for the volume quantity (the slider's gesture is sent back
// through `edit` on that token); `offered`: the player has a movable
// volume domain; `known`: a level is observed or drafted; `level`: that
// level as a whole percentage of the domain.
export struct HomewardMediaVolume { field: int, offered: bool, known: bool, level: int }

// The player itself, as the host last published it. `live`: the reading is
// a live stream (playing with no duration), shown with a badge and a radio
// glyph; `subtitle`: the header's second line ("Group of 2"), empty when the
// wire gives nothing to say; `power`: the observed power state (the wire
// carries no power command, so it is shown, never commanded);
// `can-choose-source`: the player lists sources; `source`: the one playing.
export struct HomewardMediaPlayer {
    live: bool, subtitle: string, power: ProSwitchState, can-choose-source: bool, source: string,
}

// Product composition only. Content, capabilities, privacy and exact action
// targets are supplied by the native owner; the Pro owns reusable controls.
export component HomewardMedia inherits VerticalLayout {
    in property <KitTheme> theme;
    in property <length> minimum-panel-height;
    in property <string> title;
    in property <int> generation;
    in property <bool> interactive;
    in property <bool> suspended;
    in property <bool> editable;
    in property <bool> has-data;
    in property <ProMediaPresentation> media;
    in property <HomewardMediaPlayer> player;
    in property <bool> progress-known;
    in property <float> progress;
    in property <string> position-label;
    in property <string> duration-label;
    in property <[ProMediaAction]> actions;
    in property <[ProMediaOption]> options;
    in property <[ProDeviceValue]> values;
    in property <HomewardMediaVolume> volume;
    in property <string> group-title;
    in property <string> coordinator;
    in property <[ProMediaMember]> members;
    in property <string> notice;
    in property <int> artwork-remaining-ms;
    in property <[ProDetailTool]> tools;
    callback tool-requested(int);
    callback dismiss(CloseReason);
    callback operation(int,int,ProMediaOperation);
    callback option(int,int,ProMediaOptionKind,int);
    callback edit(int,int,int,ProValueIntent);
    callback reload(int);
    callback expire-artwork(int);
    min-width: 0px;
    spacing: 12px;
    if root.has-data: ProMediaPanel {
        theme: root.theme; media: root.media; actions: root.actions; options: root.options; values: root.values;
        min-height: root.minimum-panel-height;
        title: root.title; subtitle: root.player.subtitle;
        tools: root.tools; tool-ink: root.theme.text-secondary;
        tool-requested(token) => {
            if (token == root.generation) { if (root.interactive && !root.suspended) { root.reload(root.generation); } }
            else { root.tool-requested(token); }
        }
        interactive: root.interactive; commands-enabled: root.editable;
        // A live stream wears a danger badge and a radio glyph on an artwork
        // tile lifted like a popover.
        badge: root.player.live ? "Live" : "";
        badge-tone: Tone.danger;
        artwork-glyph: root.player.live ? LucideIcons.radio() : LucideIcons.audio-lines();
        artwork-elevation: root.theme.elevation.popover;
        // The volume slider drafts a level and emits it once when the gesture
        // ends; the host's value codec admits the nearest step and sends it.
        // It is a low filled bar without a handle, read out beside it.
        can-volume: root.volume.offered; volume: root.volume.level; volume-known: root.volume.known; volume-maximum: 100;
        volume-paint: { track: root.theme.control-fill, fill: root.theme.accent-subtle, handle: transparent, edge: transparent };
        volume-height: 40px;
        volume-readout-role: TypographyRole.control;
        volume-requested(token,generation,level) => {
            root.edit(token,generation,root.volume.field,{event: start, thumb: RangeThumb.lower});
            root.edit(token,generation,root.volume.field,{event: position, thumb: RangeThumb.lower, position: level / 100.0});
            root.edit(token,generation,root.volume.field,{event: commit, thumb: RangeThumb.lower});
        }
        // No mute observation or command is exposed by the player, and no
        // power command: the observed power state is shown in the playback
        // line, not as a button. The source is chosen through the host's
        // own picker, so the panel's source trigger stays off.
        can-mute: false;
        can-power: false; power-state: root.player.power;
        can-choose-source: false; source: root.player.source;
        // The members are what the player reports in its group; the host
        // offers no per-member join, leave or volume command, so each row is
        // read-only and says so. One compact row per member under a capital
        // caption.
        members: root.members;
        member-layout: compact;
        members-label: root.group-title == "" ? "Speakers" : root.group-title;
        members-caption-uppercase: true;
        fixed-member-label: "Grouped by the player";
        dismiss(reason) => { root.dismiss(reason); }
        progress-known: root.progress-known; progress: root.progress;
        position-label: root.position-label; duration-label: root.duration-label;
        operation-requested(token,generation,operation) => { root.operation(token,generation,operation); }
        option-requested(token,generation,kind,option) => { root.option(token,generation,kind,option); }
        value-edited(token,generation,field,intent) => { root.edit(token,generation,field,intent); }
    }
    if root.has-data && root.group-title != "" && root.coordinator != "": Text { text: root.coordinator; color: root.theme.text-secondary; font-size: 13px * root.theme.text-scale; wrap: char-wrap; }
    if root.notice != "": Text { text: root.notice; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: char-wrap; }
    // Expiry does not wait for an in-flight network read or a polling interval.
    Timer {
        running: root.has-data && root.media.artwork-state == ProArtworkState.ready;
        interval: max(1,root.artwork-remaining-ms) * 1ms;
        triggered => { root.expire-artwork(root.generation); }
    }
}
