import { ProControlModules, ProModulePresentation, ProControlDensity, ProModuleIntent, ProDetailPanel } from "@kit-pro";
import { KitTheme, KitAlert, KitButton, CloseReason, StepDirection, RangeThumb } from "@kit";
import { ProDeviceRow, ProDeviceValue, ProDeviceKind, ProDeviceControls, ProValueMode, ProActionPhase, ProControlAccess,
    ProLightPanel, ProLight, ProSwitchPanel, ProSwitch, ProFanPanel, ProFan, ProClimatePanel, ProClimate,
    ProDetailTool, ProAssociatedLock, ProLockOperation, ProCoverPanel, ProCover, ProAlarmPanel, ProAlarm, ProEntityTile, ProPowerIntent, ProValueIntent } from "@kit-pro";

export struct HomewardDetailRow {
    device: ProDeviceRow, light: ProLight, switch: ProSwitch, fan: ProFan,
    associated-lock: ProAssociatedLock, lock-commands-enabled: bool,
    has-temperature: bool, temperature-field: ProDeviceValue,
    has-climate-editor: bool, climate-field: ProDeviceValue,
    climate: ProClimate, cover: ProCover, alarm: ProAlarm, alarm-code-required: bool, positioned: bool, position-minimum: float, position-maximum: float, position-step: float,
}

// One presentation per capability selected by the host. Panels own their chrome
// and interactions; the host retains exact capability/field/choice admission.
export component HomewardDeviceDetail inherits VerticalLayout {
    in property <KitTheme> theme;
    in property <length> viewport-width;
    in property <length> minimum-panel-height;
    in property <[HomewardDetailRow]> panels;
    in property <bool> interactive;
    in property <bool> commands-ready;
    in property <int> focus-request;
    in property <[ProDetailTool]> tools;
    callback tool-requested(int);
    callback dismiss(CloseReason);
    callback step(int,int,StepDirection);
    callback edit(int,int,int,ProValueIntent);
    callback choose(int,int,int);
    callback alarm-mode(int,int,int);
    callback alarm-digit(int,int,int);
    callback alarm-clear(int,int);
    callback alarm-confirm(int,int);
    callback lock-operation(int,int,ProLockOperation);
    callback power(int,int,ProPowerIntent);
    callback module-intent(ProModuleIntent);
    callback brightness(int,int,float);
    callback stop-tracking(int,int);
    width: root.viewport-width;
    spacing: 12px;
    for panel[index] in root.panels: family := VerticalLayout {
        private property <ProDeviceRow> device: panel.device;
        private property <bool> pending: device.phase == ProActionPhase.preparing || device.phase == ProActionPhase.sending || device.phase == ProActionPhase.uncertain || device.phase == ProActionPhase.accepted || device.phase == ProActionPhase.dispatched || device.phase == ProActionPhase.acknowledged || device.phase == ProActionPhase.interrupted;
        private property <bool> editable: root.commands-ready && device.access == ProControlAccess.allowed && !device.command-unavailable && !self.pending;
        private property <bool> specialized: !device.modular && (device.kind == ProDeviceKind.light || device.kind == ProDeviceKind.switch || device.kind == ProDeviceKind.climate || device.kind == ProDeviceKind.fan || device.kind == ProDeviceKind.cover || device.kind == ProDeviceKind.alarm);
        private property <bool> show-last-command: false;
        private property <bool> saw-command-in-flight: false;
        changed pending => {
            if (self.pending) { self.saw-command-in-flight = true; }
            else if (self.saw-command-in-flight) { self.show-last-command = true; self.saw-command-in-flight = false; }
        }
        spacing: 12px;
        if device.modular: ProDetailPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            title: device.title; subtitle: device.value;
            notice: device.quality; tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            dismiss(reason) => { root.dismiss(reason); }
            interactive: root.interactive;
            ProControlModules {
                theme: root.theme; context: {token: device.token,generation:device.generation};
                presentation: device.kind == ProDeviceKind.light ? ProModulePresentation.light-panel : ProModulePresentation.list;
                family: device.control-family; density: ProControlDensity.detail; modules: device.modules;
                commands-enabled: root.commands-ready;
                interactive: root.interactive;
                intent(value) => { root.module-intent(value); }
            }
        }
        if !device.modular && device.kind == ProDeviceKind.light: ProLightPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; light: panel.light;
            can-brightness: device.can-brightness; can-power: device.can-power;
            can-temperature: panel.has-temperature; canonical-temperature: panel.has-temperature;
            temperature-field: panel.temperature-field;
            temperature-edited(t,g,f,intent) => { root.edit(t,g,f,intent); }
            brightness-minimum: device.brightness-minimum; brightness-maximum: device.brightness-maximum; brightness-increment: device.brightness-step;
            interactive: root.interactive; commands-enabled: parent.editable;
            dismiss(reason) => { root.dismiss(reason); }
            power-requested(t,g,intent) => { root.power(t,g,intent); }
            brightness-requested(t,g,value) => { root.brightness(t,g,value); }
        }
        if !device.modular && device.kind == ProDeviceKind.switch: ProSwitchPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; switch: panel.switch;
            interactive: root.interactive; commands-enabled: parent.editable && device.can-power;
            dismiss(reason) => { root.dismiss(reason); }
            power-requested(t,g,intent) => { root.power(t,g,intent); }
        }
        if !device.modular && device.kind == ProDeviceKind.fan: ProFanPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; fan: panel.fan; can-power: device.can-power;
            interactive: root.interactive; commands-enabled: parent.editable;
            dismiss(reason) => { root.dismiss(reason); }
            power-requested(t,g,intent) => { root.power(t,g,intent); }
            speed-requested(t,g,choice) => { root.choose(t,g,choice); }
        }
        if !device.modular && device.kind == ProDeviceKind.climate: ProClimatePanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; climate: panel.climate;
            has-editor: panel.has-climate-editor; device: family.device; field: panel.climate-field;
            value-edited(t,g,f,intent) => { root.edit(t,g,f,intent); }
            interactive: root.interactive; commands-enabled: parent.editable;
            dismiss(reason) => { root.dismiss(reason); }
            step-requested(t,g,direction) => { root.step(t,g,direction); }
            choice-requested(t,g,group,choice) => { root.choose(t,g,choice); }
        }
        if !device.modular && device.kind == ProDeviceKind.cover: ProCoverPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; cover: panel.cover;
            paint: covering;
            associated-lock: panel.associated-lock;
            lock-commands-enabled: root.commands-ready && panel.lock-commands-enabled;
            lock-requested(t,g,operation) => { root.lock-operation(t,g,operation); }
            positioned: panel.positioned;
            position-minimum: panel.position-minimum; position-maximum: panel.position-maximum; position-increment: panel.position-step;
            position-requested(t,g,value) => {
                if (device.values.length > 0 && panel.position-maximum > panel.position-minimum) {
                    let field = device.values[0].token;
                    root.edit(t,g,field,{event: start});
                    root.edit(t,g,field,{event: position,thumb: RangeThumb.lower,position: (value - panel.position-minimum) / (panel.position-maximum - panel.position-minimum)});
                    root.edit(t,g,field,{event: commit});
                }
            }
            interactive: root.interactive; commands-enabled: parent.editable;
            dismiss(reason) => { root.dismiss(reason); }
            operation-requested(t,g,choice,operation) => { root.choose(t,g,choice); }
        }
        if !device.modular && device.kind == ProDeviceKind.alarm: ProAlarmPanel {
            private property <int> focus-request: root.focus-request;
            changed focus-request => { if (index == 0 && self.focus-request > 0) { self.take-focus(); } }
            theme: root.theme; width: root.viewport-width;
            min-height: index == 0 ? root.minimum-panel-height : 0px;
            tools: index == 0 ? root.tools : [];
            tool-requested(token) => { root.tool-requested(token); }
            title: device.title; alarm: panel.alarm; neutral-mode-selection: true; compact: root.viewport-width <= 400px; code-required: panel.alarm-code-required;
            footnote: panel.alarm-code-required ? "Code used only for this command. Not saved on this device." : "";
            interactive: root.interactive; commands-enabled: parent.editable;
            dismiss(reason) => { root.dismiss(reason); }
            mode-requested(t,g,choice) => { root.alarm-mode(t,g,choice); }
            digit-entered(t,g,digit) => { root.alarm-digit(t,g,digit); }
            digit-cleared(t,g) => { root.alarm-clear(t,g); }
            confirm-requested(t,g) => { root.alarm-confirm(t,g); }
        }
        // Extended numeric fields retain the canonical host codec: light white
        // temperature and climate domains requiring an exact text/range editor.
        if family.specialized && device.kind != ProDeviceKind.cover && device.values.length > (panel.has-temperature ? 1 : panel.has-climate-editor ? 1 : 0): VerticalLayout {
            for field in device.values: VerticalLayout { if device.kind != ProDeviceKind.cover && (!panel.has-temperature || field.token != panel.temperature-field.token) && (!panel.has-climate-editor || field.token != panel.climate-field.token): ProDeviceControls {
                theme: root.theme; context-label: device.title;
                token: device.token; generation: device.generation;
                interactive: root.interactive; editable: family.editable;
                values: [field];
                edit(t,g,f,intent) => { root.edit(t,g,f,intent); }
            } }
        }
        if family.specialized && device.action-label != "" && (family.pending || family.show-last-command): KitAlert {
            theme: root.theme; title: device.action-label; message: device.action-detail;
            severity: information;
        }
        if family.specialized && !family.pending && device.action-label != "": KitButton {
            theme: root.theme; control-size: comfortable;
            text: family.show-last-command ? "Hide last command" : "Last command";
            disabled: !root.interactive;
            activated => { family.show-last-command = !family.show-last-command; }
        }
        if family.specialized && family.pending: KitButton {
            theme: root.theme; text: "Stop Tracking"; control-size: comfortable;
            disabled: !root.interactive;
            private property <int> armed-token;
            private property <int> armed-generation;
            activation-started => { self.armed-token = device.token; self.armed-generation = device.generation; }
            activated => { root.stop-tracking(self.armed-token,self.armed-generation); }
        }
        if !device.modular && !family.specialized: ProEntityTile {
            theme: root.theme; width: root.viewport-width;
            device: device; show-details: false;
            interactive: root.interactive; commands-enabled: root.commands-ready;
            edit(t,g,f,intent) => { root.edit(t,g,f,intent); }
            choose(t,g,c) => { root.choose(t,g,c); }
            power-requested(t,g,intent) => { root.power(t,g,intent); }
            brightness-requested(t,g,value) => { root.brightness(t,g,value); }
            stop-tracking(t,g) => { root.stop-tracking(t,g); }
        }
    }
}
