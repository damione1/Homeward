import { KitDialogSurface, KitDialogPanel, KitButton, KitIconButton, KitScrollArea, KitAlert, ControlSize, CloseReason, FocusRequest, DialogTabPolicy, StepDirection } from "@kit";
import { ProLayoutNode, ProLayoutInput, ProLayoutCell, ProPowerIntent, ProValueIntent, ProGesture } from "@kit-pro";
import { HomewardDashboard } from "native-dashboard.slint";

export component HomewardPopup inherits KitDialogSurface {
    in property <int> generation;
    in property <string> title;
    in property <bool> detail;
    in property <bool> can-back;
    callback back(int);
    in property <[ProLayoutNode]> nodes;
    in property <bool> commands-enabled;
    in property <bool> content-interactive: true;
    in property <string> action-feedback;
    callback close(int,CloseReason);
    callback step(int,int,StepDirection);
    callback power(int,int,ProPowerIntent);
    callback edit(int,int,int,ProValueIntent);
    callback choose(int,int,int);
    callback brightness(int,int,float);
    callback stop-tracking(int,int);
    callback details(int,int);
    callback gesture(int,int,ProGesture);
    in property <FocusRequest> recipe-focus;
    in property <FocusRequest> tile-focus;
    callback tile-focus-revealed(int,int,length,length);
    in property <FocusRequest> widget-focus;
    in property <FocusRequest> widget-item-focus;
    callback widget-activate(int,int);
    callback task-complete(int,int,int,int,bool);
    callback agenda-select(int,int,int,int);
    callback observation-open(int,int,int,int);
    callback observation-focus-observed(int,int,int,int,bool);
    callback widget-focus-observed(int,int,bool);
    callback widget-focus-applied(int,int,int);
    callback widget-focus-revealed(int,int,length,length);

    callback recipe-focus-applied(int,int,int);
    callback recipe-focus-observed(int,int,bool);
    callback recipe-focus-revealed(int,int,length,length);
    callback scroll-interacted();
    out property <float> scroll-offset: scroll.content-y / 1px;
    public function restore-scroll(offset: float) { scroll.content-y = clamp(offset * 1px, -max(0px,scroll.content-height - scroll.visible-height),0px); }
    public function reveal-focus(top: length, bottom: length) { scroll.reveal(top - scroll.absolute-position.y - scroll.content-y,bottom - scroll.absolute-position.y - scroll.content-y); }
    private property <int> armed-generation;
    private property <bool> opened: root.state.open;
    tab-policy: DialogTabPolicy.native;
    public function take-focus() { if (root.state.open && root.state.topmost) { close-button.take-focus(); } }
    changed generation => { close-button.cancel-press(); }
    changed opened => { close-button.cancel-press(); if (root.opened) { root.take-focus(); } }
    dismiss(reason) => { root.close(root.generation, reason); }
    KitDialogPanel {
        theme: root.theme; accessible-name: root.title;
        width: max(0px, min(root.width - 32px, root.detail ? 480px : 840px));
        height: max(0px, min(root.height * 0.88, root.detail ? 680px : 704px));
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                if root.can-back: KitIconButton {
                    theme: root.theme; glyph: root.theme.icons.chevron-left;
                    accessible-name: "Back"; control-size: ControlSize.comfortable;
                    disabled: !root.state.open || !root.state.topmost || root.state.busy;
                    private property <int> pressed-generation;
                    activation-started => { self.pressed-generation = root.generation; }
                    activated => { if (self.pressed-generation == root.generation) { root.back(self.pressed-generation); } }
                }
                Text { min-width: 0px; text: root.title; color: root.theme.text-primary;
                    font-size: 22px * root.theme.text-scale; font-weight: 600;
                    wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                close-button := KitIconButton {
                    theme: root.theme; glyph: root.theme.icons.close;
                    accessible-name: "Close " + root.title; control-size: ControlSize.comfortable;
                    disabled: !root.state.open || !root.state.topmost || root.state.busy;
                    activation-started => { root.armed-generation = root.generation; }
                    activated => { if (root.armed-generation == root.generation) { root.close(root.armed-generation, CloseReason.programmatic); } }
                }
            }
            scroll := KitScrollArea {
                mouse-drag-pan-enabled: false;
                vertical-stretch: 1;
                scrolled => { root.scroll-interacted(); }
                if root.nodes.length == 0: Text { text: "This item is unavailable in the current view."; color: root.theme.text-secondary; font-size: 16px * root.theme.text-scale; wrap: word-wrap; }
                if root.action-feedback != "": KitAlert { theme: root.theme; title: "Command"; message: root.action-feedback; }
                if root.nodes.length > 0: HomewardDashboard {
                    recipe-focus: root.recipe-focus; tile-focus: root.tile-focus;
                    tile-focus-revealed(t,g,top,bottom) => { root.tile-focus-revealed(t,g,top,bottom); }
                    widget-focus: root.widget-focus; widget-item-focus: root.widget-item-focus;
                    widget-activate(t,g) => { root.widget-activate(t,g); }
                    task-complete(t,g,i,ig,v) => { if (root.commands-enabled) { root.task-complete(t,g,i,ig,v); } }
                    agenda-select(t,g,i,ig) => { root.agenda-select(t,g,i,ig); }
                    observation-open(t,g,i,ig) => { root.observation-open(t,g,i,ig); }
                    observation-focus-observed(t,g,i,ig,f) => { root.observation-focus-observed(t,g,i,ig,f); }
                    widget-focus-observed(t,g,f) => { root.widget-focus-observed(t,g,f); }
                    widget-focus-applied(t,g,r) => { root.widget-focus-applied(t,g,r); }
                    widget-focus-revealed(t,g,top,bottom) => { root.widget-focus-revealed(t,g,top,bottom); }

                    recipe-focus-applied(token,generation,serial) => { root.recipe-focus-applied(token,generation,serial); }
                    recipe-focus-observed(token,generation,focused) => { root.recipe-focus-observed(token,generation,focused); }
                    recipe-focus-revealed(token,generation,top,bottom) => { root.recipe-focus-revealed(token,generation,top,bottom); }
                    theme: root.theme; viewport-width: scroll.visible-width; screen-width: root.width;
                    nodes: root.nodes; node-index: 0;
                    interactive: root.content-interactive && root.state.open && root.state.topmost && !root.state.busy;
                    commands-enabled: root.commands-enabled;
                    step(t,g,d) => { root.step(t,g,d); }
            power(token,generation,intent) => { root.power(token,generation,intent); }
                    edit(token,generation,field,intent) => { root.edit(token,generation,field,intent); }
                    choose(token,generation,choice) => { root.choose(token,generation,choice); }
                    brightness(token,generation,value) => { root.brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.stop-tracking(token,generation); }
                    details(token,generation) => { root.details(token,generation); }
                    gesture(token,generation,gesture) => { root.gesture(token,generation,gesture); }
                }
            }
        }
    }
}
