import { KitTheme, KitThemes, KitCard, KitCardHeader, KitButton, KitWrap, KitNotificationCenter, NotificationRow, ControlSize } from "@kit";
export enum NotificationAction { refresh, register, permission, enable, disable, revoke, confirm, cancel, start-background, stop-background }
export enum NotificationRowAction { open, read, dismiss }
export struct NotificationPresentation {
    generation: int, status: string, permission: string, notice: string, permission-action-label: string,
    busy: bool, registered: bool, native-enabled: bool, can-register: bool,
    can-enable: bool, can-permission: bool, can-revoke: bool,
    confirming: bool, confirmation: string,
    background-status: string, can-start-background: bool, can-stop-background: bool,
}
export component HomewardNotifications inherits KitCard {
    accessible-role:groupbox;
    accessible-label:"Notifications";
    in property <NotificationPresentation> view;
    in property <[NotificationRow]> rows;
    in property <bool> interactive;
    callback action(int,NotificationAction);
    callback row-action(int,int,NotificationRowAction);
    KitCardHeader { theme:root.theme; title:"Notifications"; description:root.view.status; }
    if root.view.registered: Text { text:root.view.native-enabled ? "Native notifications enabled" : "Native notifications stopped"; color:root.theme.text-primary; font-size:14px * root.theme.text-scale; wrap:word-wrap; }
    Text { text:root.view.permission; color:root.theme.text-primary; font-size:14px * root.theme.text-scale; wrap:word-wrap; }
    Text { text:root.view.notice; color:root.theme.text-secondary; font-size:14px * root.theme.text-scale; wrap:word-wrap; }
    if root.view.background-status != "": Text { text:root.view.background-status; color:root.theme.text-primary; font-size:14px * root.theme.text-scale; wrap:word-wrap; }
    KitWrap {
        KitButton { theme:root.theme; control-size:comfortable; text:"Refresh"; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.refresh);} }
        if root.view.can-register: KitButton { theme:root.theme; control-size:comfortable; text:"Register This Installation"; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.register);} }
        if root.view.can-permission: KitButton { theme:root.theme; control-size:comfortable; text:root.view.permission-action-label; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.permission);} }
        if root.view.can-enable: KitButton { theme:root.theme; control-size:comfortable; text:"Enable Native Notifications"; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.enable);} }
        if root.view.can-start-background: KitButton { theme:root.theme; control-size:comfortable; text:"Receive in Background"; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.start-background);} }
        if root.view.can-stop-background: KitButton { theme:root.theme; control-size:comfortable; text:"Stop Background Reception"; disabled:!root.interactive; activated=>{root.action(root.view.generation,NotificationAction.stop-background);} }
        if root.view.registered: KitButton { theme:root.theme; control-size:comfortable; text:"Stop Showing Notifications"; disabled:!root.interactive; activated=>{root.action(root.view.generation,NotificationAction.disable);} }
        if root.view.can-revoke: KitButton { theme:root.theme; control-size:comfortable; text:"Revoke Destination"; disabled:!root.interactive || root.view.busy || root.view.confirming; activated=>{root.action(root.view.generation,NotificationAction.revoke);} }
    }
    if root.view.confirming: VerticalLayout {
        spacing:12px;
        Text { text:root.view.confirmation; color:root.theme.text-primary; font-size:14px * root.theme.text-scale; wrap:word-wrap; }
        KitWrap {
            KitButton { theme:root.theme; control-size:comfortable; text:"Confirm"; disabled:!root.interactive || root.view.busy; activated=>{root.action(root.view.generation,NotificationAction.confirm);} }
            KitButton { theme:root.theme; control-size:comfortable; text:"Cancel"; disabled:!root.interactive || root.view.busy; activated=>{root.action(root.view.generation,NotificationAction.cancel);} }
        }
    }
    KitNotificationCenter {
        theme:root.theme; control-size:comfortable; rows:root.rows;
        disabled:!root.interactive || root.view.busy || root.view.confirming;
        empty-label:"No notifications";
        empty-description:"Only messages that are still valid for this installation are shown.";
        open-label:"Open"; mark-read-label:"Mark as Read"; read-label:"Read"; dismiss-label:"Remove";
        activate(t,g)=>{root.row-action(t,g,NotificationRowAction.open);}
        mark-read(t,g)=>{root.row-action(t,g,NotificationRowAction.read);}
        dismiss-row(t,g)=>{root.row-action(t,g,NotificationRowAction.dismiss);}
    }
}
