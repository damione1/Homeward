import { KitTheme, KitThemes, TableColumn, TableRow, NavigationStep } from "@kit";
import { ProAdminWorkspace, ProAdminEditor, ProAdminStage, ProAdminAction, ProAdminSection, ProAdminActionRow, ProAdminField, ProAdminChoice } from "@kit-pro";
export component HomewardAdministration inherits VerticalLayout {
    in property <KitTheme> theme: KitThemes.light;
    in property <string> title;
    in property <string> description: "Account, access, configuration and server status";
    in property <string> status;
    in property <string> notice;
    in property <ProAdminStage> stage;
    in property <int> generation;
    in property <int> active-index: -1;
    in property <int> selected-token;
    in property <[ProAdminSection]> sections;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    in property <[ProAdminField]> fields;
    in property <[ProAdminChoice]> choices;
    in property <bool> editor-visible;
    in property <bool> editable;
    in property <string> editor-title;
    in property <string> editor-notice;
    in property <[ProAdminActionRow]> actions;
    in property <[ProAdminActionRow]> editor-actions;
    callback choose-section(int,int);
    callback select(int,int);
    callback action(int,int,ProAdminAction);
    callback navigate(NavigationStep);
    callback edit(int,int,int,string);
    callback choose(int,int,int,int);
    callback editor-action(int,int,ProAdminAction);
    spacing: 16px;
    ProAdminWorkspace {
        interactive: !root.editor-visible;
        theme: root.theme; title: root.title;
        description: root.description;
        stage: root.stage; status-label: root.status; notice: root.notice;
        empty-label: "No entries for this view";
        generation: root.generation; active-index: root.active-index;
        sections: root.sections; columns: root.columns; rows: root.rows; actions: root.actions;
        choose-section(t,g) => { root.choose-section(t,g); }
        select(t,g) => { root.select(t,g); }
        navigate(step) => { root.navigate(step); }
        action(t,g,a) => { root.action(t,g,a); }
    }
    if root.editor-visible || root.fields.length > 0: ProAdminEditor {
        theme: root.theme; title: root.editor-title;
        description: "Authorized information for the current session";
        token: root.selected-token; generation: root.generation;
        editable: root.editable; fields: root.fields; choices: root.choices; actions: root.editor-actions;
        notice: root.editor-notice;
        reveal-label: "Show Password"; hide-label: "Hide Password";
        edit(t,g,f,value) => { root.edit(t,g,f,value); }
        choose(t,g,f,option) => { root.choose(t,g,f,option); }
        action(t,g,a) => { root.editor-action(t,g,a); }
    }
}
