    changed page => { root.dashboard-widgets-changed(); }
    changed room-view => { root.dashboard-widgets-changed(); }
    changed native-popup => { root.dashboard-widgets-changed(); }
    public function take-shell-focus(target: ProShellFocus) {
        if (root.connected && !root.show-endpoint) {
            shell.take-focus(target);
        }
    }
    public function take-body-focus(target: BodyFocus) {
        if (!root.connected || root.show-endpoint) { return; }
        if (target == BodyFocus.read) {
            if (!root.view-loaded) { read-button.take-focus(); }
            else if (root.page == ViewPage.home) {
                if (!root.dashboard-focus-first()) { shell.take-focus(ProShellFocus.search); }
            } else { root.take-shell-focus(ProShellFocus.workspace); }
        }
        else if (target == BodyFocus.inventory) { table.take-focus(); }
        else if (target == BodyFocus.back) { if (root.page == ViewPage.detail) { root.detail-focus-request += 1; } else if (root.page == ViewPage.room && root.room-view == RoomView.cards) { room-back.take-focus(); } else { back-button.take-focus(); } }
        else if (target == BodyFocus.lists) { lists-pane.take-focus(); }
        else if (target == BodyFocus.calendars) { calendars-pane.focus-catalog(); }
        else if (target == BodyFocus.cameras) { cameras-pane.focus-catalog(); }
        else if (target == BodyFocus.settings) { theme-button.take-focus(); }
        else if (target == BodyFocus.popup) { popup-dialog.take-focus(); }
    }
    // Native Back may arrive without the popup's keyboard focus. Ask the
    // currently displayed owner directly; never synthesize another key event.
    public function dismiss-selection-popover() -> bool {
        if (root.page == ViewPage.lists) { return lists-pane.dismiss-selection-popover(); }
        if (root.page == ViewPage.calendars) { return calendars-pane.dismiss-selection-popover(); }
        return false;
    }
    public function reset-list() { root.cache-active-index = 0; table.reveal-active(); }
    public function restore-board-scroll(home-offset: float, room-offset: float, popup-offset: float) {
        home.content-y = clamp(home-offset * 1px, -max(0px, home.content-height - home.visible-height), 0px);
        room-area.content-y = clamp(room-offset * 1px, -max(0px, room-area.content-height - room-area.visible-height), 0px);
        popup-dialog.restore-scroll(popup-offset);
    }
    public function reveal-recipe(top: length, bottom: length) {
        if (root.recipe-confirmation.open) { return; }
        if (root.native-popup.open) { popup-dialog.reveal-focus(top,bottom); }
        else if (root.page == ViewPage.rooms) { rooms-area.reveal(top - rooms-area.absolute-position.y - rooms-area.content-y,bottom - rooms-area.absolute-position.y - rooms-area.content-y); }
        else if (root.page == ViewPage.home) { home.reveal(top - home.absolute-position.y - home.content-y, bottom - home.absolute-position.y - home.content-y); }
        else if (root.page == ViewPage.room && root.room-view == RoomView.cards) { room-area.reveal(top - room-area.absolute-position.y - room-area.content-y, bottom - room-area.absolute-position.y - room-area.content-y); }
    }
    function preferences-edited() { root.preferences-changed(root.dark-mode, root.opaque-surfaces, root.large-text, root.reduced-motion); }

    content := FocusScope {
    x: root.safe-area-insets.left; y: root.safe-area-insets.top;
    width: max(0px, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
    height: max(0px, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
    focus-on-tab-navigation: false;
    key-pressed(event) => {
        if (event.text == Key.Back && root.system-back()) { return accept; }
        return reject;
    }
    if !root.connected || root.show-endpoint: KitScrollArea {
        width: content.width; height: content.height;
        inset: roomy; gap: roomy;
        Text { text: "Homeward"; color: root.theme.text-primary; font-size: 30px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
        if root.show-endpoint: KitCard {
            theme: root.theme;
            KitCardHeader { theme: root.theme; title: "Your Server";
                description: "Connect securely to your Homeward server."; }
            KitUrlField { theme: root.theme; control-size: comfortable; label: "Server Address";
                placeholder: "https://home.example.com"; text <=> root.server-draft; }
            KitCheckbox { theme: root.theme; label: "Use a private certificate (advanced)";
                state: root.use-private-certificate ? CheckState.checked : CheckState.unchecked;
                toggled(state) => { root.use-private-certificate = state == CheckState.checked; } }
            if root.use-private-certificate: KitTextArea { theme: root.theme; control-size: comfortable; label: "Trusted Certificate (PEM)";
                min-lines: 3; max-lines: 5; text <=> root.certificate-draft;
                input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false }; }
            if root.setup-message != "": KitAlert {
                theme: root.theme; title: "Connect to Server"; message: root.setup-message;
            }
            KitButton { theme: root.theme; control-size: comfortable; text: "Use This Server"; control-width: ControlWidth.fill;
                disabled: root.server-draft == "" || (root.use-private-certificate && root.certificate-draft == "");
                activated => { root.connect-endpoint(root.server-draft, root.use-private-certificate ? root.certificate-draft : ""); } }
        }
        if root.endpoint-ready && !root.show-endpoint: KitStack {
            Text { text: root.endpoint-label; color: root.theme.text-secondary;
                font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
            if root.use-private-certificate: Text { text: "SHA-256 Trust: " + root.trust-fingerprint; color: root.theme.text-secondary;
                font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            if root.recovery-receipt != "": KitCard {
                theme: root.theme;
                KitCardHeader { theme: root.theme; title: "New Recovery Codes";
                    description: "Keep these codes now. Previous codes are invalid, and you must sign in again."; }
                KitTextArea { theme: root.theme; control-size: comfortable; label: "Codes to Keep"; access: FieldAccess.read-only;
                    text: root.recovery-receipt; min-lines: 5; max-lines: 10; }
                KitButton { theme: root.theme; control-size: comfortable; text: "I Saved the Codes · Close";
                    activated => { root.close-recovery-receipt(); } }
            }
            if !root.invitation-visible && root.recovery-receipt == "": ProAccessPanel {
                theme: root.theme; control-size: ControlSize.comfortable; stage: root.access-stage; title: "Welcome Home";
                description: "Sign in to your installation.";
                user-label: "Username"; password-label: "Password"; submit-label: "Sign In";
                verification-title: "Additional Verification";
                verification-help: "This account requires a second factor. FIDO2 security keys are not yet supported by this client.";
                factor-label: "Security key · unsupported";
                recovery-choice-label: "Use a Recovery Code";
                recovery-label: "Recovery Code"; recovery-submit-label: "Verify Code";
                enrollment-title: "Enrollment required";
                enrollment-help: "A security key must be registered before continuing. Use a client with a qualified FIDO2 provider, then sign in here again.";
                enroll-label: "Enrollment unavailable on this client";
                connected-title: root.session-title;
                connected-description: root.session-description;
                connected-severity: root.session-severity;
                sign-out-label: "Sign Out"; restart-label: "Start Again";
                show-label: "Show"; hide-label: "Hide"; cancel-label: "Cancel";
                busy-label: "Signing in…"; busy: root.busy; can-recover: root.can-recover;
                message-title: root.message-title; message: root.message; message-severity: root.message-severity;
                user-draft <=> root.user-draft; password-draft <=> root.password-draft; recovery-draft <=> root.recovery-draft;
                sign-in(user, password) => { root.sign-in(user, password); }
                choose-recovery => { root.access-stage = ProAccessStage.recovery; }
                verify-recovery(code) => { root.verify-recovery(code); }
                restart => { root.cancel-access(); }
                cancel => { root.cancel-access(); }
                sign-out => { root.sign-out(); }
            }
            if root.access-stage == ProAccessStage.identity && !root.invitation-visible && root.recovery-receipt == "": KitButton {
                theme: root.theme; control-size: comfortable; text: "I Have an Invitation";
                disabled: root.busy || root.invitation-generation >= 2147483647;
                activated => { root.clear-invitation(); root.password-draft = ""; root.recovery-draft = ""; root.invitation-visible = true; }
            }
            if root.invitation-visible: KitCard {
                theme: root.theme;
                KitCardHeader { theme: root.theme; title: "Accept Invitation";
                    description: "Use the token provided by your administrator. Sign in to your account separately afterward."; }
                KitTextField { theme: root.theme; control-size: comfortable; label: "Invitation Token";
                    purpose: TextPurpose.password; reveal-label: "Show Token"; hide-label: "Hide Token";
                    access: root.invitation-busy || root.invitation-uncertain ? FieldAccess.read-only : FieldAccess.editable;
                    text <=> root.invitation-token-draft; }
                KitTextField { theme: root.theme; control-size: comfortable; label: "Your Name";
                    access: root.invitation-busy || root.invitation-uncertain ? FieldAccess.read-only : FieldAccess.editable;
                    text <=> root.invitation-name-draft; }
                KitTextField { theme: root.theme; control-size: comfortable; label: "Your Password";
                    purpose: TextPurpose.password; reveal-label: "Show Password"; hide-label: "Hide Password";
                    access: root.invitation-busy || root.invitation-uncertain ? FieldAccess.read-only : FieldAccess.editable;
                    text <=> root.invitation-password-draft; }
                if root.invitation-feedback != "": KitAlert { theme: root.theme; title: "Invitation"; message: root.invitation-feedback; }
                KitWrap {
                    KitButton { theme: root.theme; control-size: comfortable; text: root.invitation-busy ? "Accepting…" : "Accept Invitation";
                        disabled: root.invitation-busy || root.invitation-uncertain || root.invitation-token-draft == "" || root.invitation-password-draft == "";
                        activated => { root.accept-invitation(root.invitation-generation,root.invitation-token-draft,root.invitation-password-draft,root.invitation-name-draft); } }
                    KitButton { theme: root.theme; control-size: comfortable; text: "Back to Sign In";
                        activated => { root.clear-invitation(); } }
                }
            }
            KitButton { theme: root.theme; control-size: comfortable; text: "Change Server";
                activated => { root.password-draft = ""; root.recovery-draft = ""; root.show-endpoint = true; } }
        }

    }
    shell := ProAdaptiveShell {
        interactive: root.background-interactive;
        width: content.width; height: content.height;
        visible: root.connected && !root.show-endpoint;
        theme: root.theme; product-name: "Homeward"; brand-glyph: LucideNavigation.compass(); workspace-label: root.dashboard-title;
        floating-navigation: true; compact-breakpoint: 600px;
        subtitle: root.page == ViewPage.home ? "" : root.local-date;
        navigation-glyphs: [KitGlyphs.home(), LucideHome.door-open(), KitGlyphs.cart(), LucideTime.calendar-days(), LucideDevices.video(), KitGlyphs.settings()];
        notifications-visible: false;
        page-title: root.page == ViewPage.home ? root.dashboard-title : root.page-title;
        status: root.view-loaded ? "" : (root.read-status == "" ? root.session-title : root.read-status);
        navigation-label: "Navigation"; close-label: "Close Navigation";
        search-label: "Search My Home"; search-placeholder: "Search for an item…"; clear-search-label: "Clear Search";
        query <=> root.search-query;
        navigation-rows: root.navigation-rows; navigation-state: root.navigation-state; drawer-state: root.navigation-drawer;
        navigation-open => { root.navigation-open(); }
        navigation-dismiss(reason) => { root.navigation-dismiss(reason); }
        navigation-activate(token,generation) => { root.navigation-activate(token,generation); }
        navigation-step(step) => { root.navigation-step(step); }
        navigation-typeahead(text) => { root.navigation-typeahead(text); }
        query-edited(text) => { root.query-edited(text); }
        workspace-requested => { root.choose-room(); }
        focus-next(reverse) => { root.modal-next(reverse); }
        focus-observed(target,focused) => { root.shell-observed(target,focused); }
        restore-focus => { root.shell-restore(); }
        compact-changed(compact) => { root.shell-compact(compact); }
        content-focus-requested => { root.content-focus(); }
        VerticalLayout {
          spacing: 8px;
          HomewardConnectionBanner { theme: root.theme; status: root.connection-status; interactive: root.content-interactive; retry => { root.read-protected(); } }
        viewport := Rectangle {
            min-width: 0px; min-height: 0px; max-width: 100000px; max-height: 100000px;
            horizontal-stretch: 1; vertical-stretch: 1;
            cameras-pane:=HomewardCameras {
                width:viewport.width;height:viewport.height;visible:root.page == ViewPage.cameras;
                theme:root.theme;data:root.cameras;interactive:root.camera-interactive;
                video:root.video;
                open-video(t,g)=>{if(!root.cameras-publishing){root.cameras-open-video(t,g);}}
                video-action(t,g,a)=>{root.video-action(t,g,a);}
                video-viewport(visible)=>{root.video-viewport(visible);}
                video-expire(g)=>{root.video-expire(g);}
                choose(t,g)=>{if(!root.cameras-publishing){root.cameras-choose(t,g);}}
                event(t,g)=>{if(!root.cameras-publishing){root.cameras-event(t,g);}}
                snapshot(t,g)=>{if(!root.cameras-publishing){root.cameras-snapshot(t,g);}}
                reload(t,g)=>{if(!root.cameras-publishing){root.cameras-reload(t,g);}}
                reload-catalog(g)=>{if(!root.cameras-publishing){root.cameras-reload-catalog(g);}}
                catalog-navigate(step)=>{root.cameras-catalog-navigate(step);}
                viewport(visible)=>{root.cameras-viewport(visible);}
                navigate(step)=>{root.cameras-navigate(step);}
                expire(g)=>{root.cameras-expire(g);}
            }
            calendars-pane := HomewardCalendars {
                width: viewport.width; height: viewport.height; visible: root.page == ViewPage.calendars;
                theme: root.theme; data: root.calendars; interactive: root.calendar-interactive;
                edit-summary <=> root.calendars-edit-summary;
                edit-description <=> root.calendars-edit-description;
                edit-location <=> root.calendars-edit-location;
                edit-start-date <=> root.calendars-edit-start-date;
                edit-end-date <=> root.calendars-edit-end-date;
                edit-start-time <=> root.calendars-edit-start-time;
                edit-end-time <=> root.calendars-edit-end-time;
                edit-zone <=> root.calendars-edit-zone;

                name-draft <=> root.calendars-name; range-start <=> root.calendars-start; range-end <=> root.calendars-end; range-zone <=> root.calendars-zone;
                choose(t,g) => { root.calendars-choose(t,g); }
                select(t,g) => { root.calendars-select(t,g); }
                command(g,a,x,y,z) => { root.calendars-command(g,a,x,y,z); }
                edited(t,g,f,v) => { if (!root.calendars-publishing) { root.calendars-edit(t,g,f,v); } }
                date-edited(t,g,b,v) => { if (!root.calendars-publishing) { root.calendars-date(t,g,b,v); } }
                time-edited(t,g,b,v) => { if (!root.calendars-publishing) { root.calendars-time(t,g,b,v); } }
                resolve(t,g,b,v) => { if (!root.calendars-publishing) { root.calendars-resolve(t,g,b,v); } }
                ambiguity-chosen(t,g,b,c) => { if (!root.calendars-publishing) { root.calendars-ambiguity(t,g,b,c); } }
                kind-requested(t,g,k) => { if (!root.calendars-publishing) { root.calendars-kind(t,g,k); } }
                action(t,g,a) => { if (!root.calendars-publishing) { root.calendars-action(t,g,a); } }
                mode-requested(mode) => { root.calendars-mode(mode); }
                navigate(step) => { root.calendars-navigate(step); }
                day-requested(t,g) => { root.calendars-day(t,g); }
                date-chosen(day) => { root.calendars-date-chosen(day); }
                month-requested(direction) => { root.calendars-month(direction); }
            }
            lists-pane := HomewardLists {
                list-token: root.lists-list-token; options: root.lists-options;
                option-index: root.lists-option-index;
                grocery-rows: root.lists-grocery-rows; suggestions: root.lists-suggestions;
                width: viewport.width; height: viewport.height; visible: root.page == ViewPage.lists;
                create-draft <=> root.lists-create-draft; rename-draft <=> root.lists-rename-draft; add-draft <=> root.lists-add-draft;
                theme: root.theme; generation: root.lists-generation; catalog: root.lists-catalog; tasks: root.lists-tasks;
                catalog-ready: root.lists-catalog-ready; write-ready: root.lists-write-ready; busy: root.lists-busy;
                selected: root.lists-selected; title: root.lists-title; catalog-count: root.lists-catalog-count; item-count: root.lists-item-count;
                notice: root.lists-notice; cached-at: root.lists-cached-at; access: root.lists-access;
                task-selected: root.lists-task-selected; task-selection: root.lists-task-selection; active-index: root.lists-active-index; draft <=> root.lists-draft;
                filter-options(rows,query) => { return root.lists-filter-options(rows,query); }
                find-option(rows,prefix) => { return root.lists-find-option(rows,prefix); }
                choose(t,g) => { root.lists-choose(t,g); }
                select-task(t,g) => { root.lists-select-task(t,g); }
                edit(t,g,v) => { root.lists-edit(t,g,v); }
                complete(t,g,v) => { root.lists-complete(t,g,v); }
                grocery-complete(lt,lg,t,g,v) => { root.lists-grocery-complete(lt,lg,t,g,v); }
                grocery-select(lt,lg,t,g) => { root.lists-grocery-select(lt,lg,t,g); }
                grocery-remove(lt,lg,t,g) => { root.lists-grocery-remove(lt,lg,t,g); }
                grocery-quick-add(lt,lg,t,g) => { root.lists-grocery-quick-add(lt,lg,t,g); }
                grocery-add(lt,lg,v) => { root.lists-grocery-add(lt,lg,v); }
                action(t,g,a) => { root.lists-action(t,g,a); }
                create(g,v) => { root.lists-create(g,v); }
                rename(g,v) => { root.lists-rename(g,v); }
                delete(g) => { root.lists-delete(g); }
                add(g,v) => { root.lists-add(g,v); }
                reload(g) => { root.lists-reload(g); }
                navigate(step) => { root.lists-navigate(step); }
            }
            home := KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.displayed-page == ViewPage.home;
                scrolled => { root.native-focus-cancelled(); }
                gap: root.view-loaded && root.dashboard-status == "" ? none : roomy;
                Rectangle {
                    height: root.view-loaded && root.dashboard-status == "" ? 0px : read-button.preferred-height;
                    visible: !root.view-loaded || root.dashboard-status != "";
                    read-button := KitButton { x: 0px; y: 0px; width: min(parent.width, 250px * root.theme.text-scale);
                        theme: root.theme; control-size: comfortable; control-width: ControlWidth.fill; disabled: root.busy || !root.content-interactive;
                        text: "Show My Home"; busy: root.busy; activated => { root.read-protected(); } }
                }
                if root.dashboard-choices.length > 1: KitSelect {
                    theme: root.theme; rows: root.dashboard-choices; state: root.dashboard-choice-state;
                    placeholder: "Choose Dashboard"; control-size: comfortable;
                    access: root.content-interactive ? FieldAccess.editable : FieldAccess.disabled;
                    open-requested => { root.dashboard-choice-open(); }
                    activate(token,generation) => { root.dashboard-choice-activate(token,generation); }
                    navigate(step) => { root.dashboard-choice-step(step); }
                    dismiss(reason) => { root.dashboard-choice-dismiss(reason); }
                    typeahead(text) => { root.dashboard-choice-typeahead(text); }
                }
                if root.dashboard-synthetic: KitAlert { theme: root.theme; title: "Test Server"; message: "Synthetic data · no real devices"; severity: information; }
                if root.dashboard-status != "": KitAlert { theme: root.theme; title: "Dashboard"; message: root.dashboard-status; severity: information; }
                if root.home-layout-nodes.length > 0: HomewardDashboard {
                    step(t,g,d) => { root.device-step(t,g,d); }
                    recipe-focus: root.recipe-focus; tile-focus: root.tile-focus;
                    tile-focus-revealed(t,g,top,bottom) => { if (root.tile-focus.present && root.tile-focus.token == t && root.tile-focus.generation == g && !root.cohort-pending) { root.reveal-recipe(top,bottom); } }
                    widget-focus: root.widget-focus; widget-item-focus: root.widget-item-focus;
                    widget-activate(t,g) => { root.dashboard-widget-activate(t,g); }
                    task-complete(t,g,i,ig,v) => { if (root.commands-ready) { root.dashboard-task-complete(t,g,i,ig,v); } }
                    agenda-select(t,g,i,ig) => { root.dashboard-agenda-select(t,g,i,ig); }
                    observation-open(t,g,i,ig) => { root.dashboard-observation-open(t,g,i,ig); }
                    observation-focus-observed(t,g,i,ig,f) => { root.dashboard-observation-focus(t,g,i,ig,f); }
                    widget-focus-observed(t,g,f) => { root.dashboard-widget-focus(t,g,f); }
                    widget-focus-applied(t,g,r) => { root.dashboard-widget-focus-applied(t,g,r); }
                    widget-focus-revealed(t,g,top,bottom) => { root.dashboard-widget-focus-revealed(t,g,top,bottom); }

                    recipe-focus-applied(token,generation,serial) => { root.recipe-focus-applied(token,generation,serial); }
                    recipe-focus-observed(token,generation,focused) => { root.recipe-focus-observed(token,generation,focused); }
                    recipe-focus-revealed(token,generation,top,bottom) => { root.recipe-focus-revealed(token,generation,top,bottom); }
                    theme: root.theme; viewport-width: home.visible-width; screen-width: root.width;
                    nodes: root.home-layout-nodes; node-index: 0;
                    interactive: root.dashboard-interactive && root.page == ViewPage.home; commands-enabled: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    edit(token,generation,field,intent) => { root.device-edit(token,generation,field,intent); }
                    choose(token,generation,choice) => { root.device-choice(token,generation,choice); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                    details(token,generation) => { root.device-details(token,generation); }
                    gesture(token,generation,gesture) => { root.recipe-gesture(token,generation,gesture); }
                }
                if root.action-feedback != "" && root.page != ViewPage.detail && !root.native-popup.open: KitAlert { theme: root.theme; title: "Update"; message: root.action-feedback; severity: information; }
                if root.cache-error != "": KitAlert { theme: root.theme; title: "Last Reading"; message: root.cache-error; severity: warning; }
            }
            rooms-area := KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.displayed-page == ViewPage.rooms;
                scrolled => { root.native-focus-cancelled(); }
                if root.rooms-layout-nodes.length > 0: HomewardDashboard {
                    step(t,g,d) => { root.device-step(t,g,d); }
                    theme: root.theme; viewport-width: rooms-area.visible-width; screen-width: root.width;
                    nodes: root.rooms-layout-nodes; node-index: 0;
                    interactive: root.dashboard-interactive && root.page == ViewPage.rooms;
                    commands-enabled: root.commands-ready;
                    recipe-focus: root.recipe-focus; tile-focus: root.tile-focus;
                    tile-focus-revealed(t,g,top,bottom) => { if (root.tile-focus.present && root.tile-focus.token == t && root.tile-focus.generation == g && !root.cohort-pending) { root.reveal-recipe(top,bottom); } } widget-focus: root.widget-focus;
                    widget-item-focus: root.widget-item-focus;
                    widget-activate(t,g) => { root.dashboard-widget-activate(t,g); }
                    widget-focus-observed(t,g,f) => { root.dashboard-widget-focus(t,g,f); }
                    widget-focus-applied(t,g,r) => { root.dashboard-widget-focus-applied(t,g,r); }
                    widget-focus-revealed(t,g,top,bottom) => { root.dashboard-widget-focus-revealed(t,g,top,bottom); }
                    recipe-focus-applied(t,g,r) => { root.recipe-focus-applied(t,g,r); }
                    recipe-focus-observed(t,g,f) => { root.recipe-focus-observed(t,g,f); }
                    recipe-focus-revealed(t,g,top,bottom) => { root.recipe-focus-revealed(t,g,top,bottom); }
                }
                if root.rooms-layout-nodes.length == 0: ProHomeOverview {
                    theme: root.theme; viewport-width: rooms-area.visible-width; spacing: 12px;
                    rooms-title: "Choose a Room"; rooms: root.home-rooms;
                    interactive: root.dashboard-interactive && root.page == ViewPage.rooms;
                    focus-request: root.home-focus;
                    room-open(token,generation) => { root.room-open(token,generation); }
                    room-focus-observed(token,generation,focused) => { root.home-observed(token,generation,focused); }
                }
            }
            room-area := KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.displayed-page == ViewPage.room && root.room-view == RoomView.cards;
                scrolled => { root.native-focus-cancelled(); }
                room-back := KitButton { control-width: ControlWidth.intrinsic; disabled: !root.connected; theme: root.theme; text: "Back"; control-size: comfortable; activated => { root.go-back(); } }
                if root.room-layout-nodes.length == 0 && root.device-cards.length == 0: Text { text: "No cards are available for this room’s capabilities. The full list is still available."; color: root.theme.text-secondary; font-size: 16px * root.theme.text-scale; wrap: word-wrap; }
                if root.action-feedback != "" && root.page != ViewPage.detail && !root.native-popup.open: KitAlert { theme: root.theme; title: "Update"; message: root.action-feedback; severity: information; }
                if root.room-layout-nodes.length > 0: HomewardDashboard {
                    step(t,g,d) => { root.device-step(t,g,d); }
                    recipe-focus: root.recipe-focus; tile-focus: root.tile-focus;
                    tile-focus-revealed(t,g,top,bottom) => { if (root.tile-focus.present && root.tile-focus.token == t && root.tile-focus.generation == g && !root.cohort-pending) { root.reveal-recipe(top,bottom); } }
                    widget-focus: root.widget-focus; widget-item-focus: root.widget-item-focus;
                    widget-activate(t,g) => { root.dashboard-widget-activate(t,g); }
                    task-complete(t,g,i,ig,v) => { if (root.commands-ready) { root.dashboard-task-complete(t,g,i,ig,v); } }
                    agenda-select(t,g,i,ig) => { root.dashboard-agenda-select(t,g,i,ig); }
                    observation-open(t,g,i,ig) => { root.dashboard-observation-open(t,g,i,ig); }
                    observation-focus-observed(t,g,i,ig,f) => { root.dashboard-observation-focus(t,g,i,ig,f); }
                    widget-focus-observed(t,g,f) => { root.dashboard-widget-focus(t,g,f); }
                    widget-focus-applied(t,g,r) => { root.dashboard-widget-focus-applied(t,g,r); }
                    widget-focus-revealed(t,g,top,bottom) => { root.dashboard-widget-focus-revealed(t,g,top,bottom); }

                    recipe-focus-applied(token,generation,serial) => { root.recipe-focus-applied(token,generation,serial); }
                    recipe-focus-observed(token,generation,focused) => { root.recipe-focus-observed(token,generation,focused); }
                    recipe-focus-revealed(token,generation,top,bottom) => { root.recipe-focus-revealed(token,generation,top,bottom); }
                    theme: root.theme; viewport-width: room-area.visible-width; screen-width: root.width;
                    nodes: root.room-layout-nodes; node-index: 0;
                    interactive: root.dashboard-interactive && root.page == ViewPage.room && root.room-view == RoomView.cards; commands-enabled: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    edit(token,generation,field,intent) => { root.device-edit(token,generation,field,intent); }
                    choose(token,generation,choice) => { root.device-choice(token,generation,choice); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                    details(token,generation) => { root.device-details(token,generation); }
                    gesture(token,generation,gesture) => { root.recipe-gesture(token,generation,gesture); }
                }
                if !root.has-configured-layout && root.room-layout-nodes.length == 0: HomewardDevices {
                    theme: root.theme; viewport-width: viewport.width; devices: root.device-cards;
                    interactive: root.dashboard-interactive && root.page == ViewPage.room && root.room-view == RoomView.cards; commands-ready: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    edit(token,generation,field,intent) => { root.device-edit(token,generation,field,intent); }
                    choose(token,generation,choice) => { root.device-choice(token,generation,choice); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                    details(token,generation) => { root.device-details(token,generation); }
                }
                KitButton { disabled: !root.content-interactive; visible: !root.native-page && root.page != ViewPage.detail; theme: root.theme; text: "All Items"; control-size: comfortable; activated => { root.room-view = RoomView.list; root.content-focus(); } }
            }
            inventory := Rectangle {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.displayed-page == ViewPage.inventory || (root.displayed-page == ViewPage.room && root.room-view == RoomView.list);
                VerticalLayout {
                    spacing: 12px;
                    back-button := KitButton { control-width: ControlWidth.intrinsic; disabled: !root.connected; theme: root.theme; control-size: comfortable; text: "Back"; activated => { if (root.page == ViewPage.room) { root.room-view = RoomView.cards; root.content-focus(); } else { root.go-back(); } } }
                    table := KitDataTable {
                        interactive: root.dashboard-interactive;
                        theme: root.theme; control-size: comfortable; label: "Installation States";
                        empty-label: root.search-query == "" ? "No observations available." : "No results for this search.";
                        rows: root.cache-rows; active-index: root.cache-active-index; generation: root.cache-generation;
                        vertical-stretch: 1;
                        columns: [
                            { token: 0, label: "Item", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading },
                            { token: 1, label: "State", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading },
                            { token: 2, label: "Quality", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading }
                        ];
                        private property <length> projected-row-height: KitMetrics.control-height(root.theme, ControlSize.comfortable) + 8px;
                        private property <int> first-visible: max(0, floor(-self.scroll-y / self.projected-row-height));
                        private property <int> visible-count: min(64, ceil(self.height / self.projected-row-height) + 16);
                        init => { root.cache-viewport(self.first-visible, self.visible-count); }
                        changed first-visible => { root.cache-viewport(self.first-visible, self.visible-count); }
                        changed visible-count => { root.cache-viewport(self.first-visible, self.visible-count); }
                        navigate(step) => { root.cache-navigate(step); }
                        activate(token,generation) => { root.cache-activate(token,generation); }
                    }
                }
            }
            settings-pane := KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.settings;
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: "Make It Yours"; description: "Device Settings"; }
                    KitWrap {
                        theme-button := KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: root.dark-mode ? "Light Theme" : "Dark Theme"; activated => { root.dark-mode = !root.dark-mode; root.preferences-edited(); } }
                        KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: root.opaque-surfaces ? "Translucent Surfaces" : "Opaque Surfaces"; activated => { root.opaque-surfaces = !root.opaque-surfaces; root.preferences-edited(); } }
                        KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: root.large-text ? "Standard Text" : "200 % Text"; activated => { root.large-text = !root.large-text; root.preferences-edited(); } }
                        KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: root.reduced-motion ? "Allow Animations" : "Reduce Motion"; activated => { root.reduced-motion = !root.reduced-motion; root.preferences-edited(); } }
                    }
                    Text { text: root.preferences-status; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                }
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: "Inventory"; description: "Inspect all equipment and installation states."; }
                    KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; control-width: ControlWidth.intrinsic;
                        text: "Open Inventory"; activated => { root.show-inventory(); } }
                }
                HomewardAdministration {
                    theme: root.theme; title: root.admin-title; status: root.admin-status; notice: root.admin-notice;
                    stage: root.admin-stage; generation: root.admin-generation; active-index: root.admin-active-index;
                    selected-token: root.admin-selected-token; sections: root.admin-sections; columns: root.admin-columns;
                    rows: root.admin-rows; fields: root.admin-fields; actions: root.admin-actions; editor-actions: root.admin-editor-actions;
                    choices: root.admin-choices; editor-visible: root.admin-editor-visible; editable: root.admin-editable;
                    editor-title: root.admin-editor-title; editor-notice: root.admin-editor-notice;
                    choose-section(t,g) => { root.admin-choose-section(t,g); }
                    select(t,g) => { root.admin-select(t,g); }
                    action(t,g,a) => { root.admin-action(t,g,a); }
                    navigate(step) => { root.admin-navigate(step); }
                    edit(t,g,f,value) => { root.admin-edit(t,g,f,value); }
                    choose(t,g,f,option) => { root.admin-choose(t,g,f,option); }
                    editor-action(t,g,a) => { root.admin-editor-action(t,g,a); }
                }
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: root.session-title; description: root.session-description; }
                    Text { text: root.endpoint-label; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                    KitWrap {
                        KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: "Sign Out"; activated => { root.sign-out(); } }
                        KitButton { disabled: !root.content-interactive; theme: root.theme; control-size: comfortable; text: "Change Server"; activated => { root.cancel-access(); root.show-endpoint = true; } }
                    }
                }
            }
        }
    }
    }
}
    detail-dialog := KitDialogSurface {
        width: root.width; height: root.height; theme: root.theme;
        state: {open: root.page == ViewPage.detail && root.connected && !root.show-endpoint,topmost: !root.recipe-confirmation.open,busy:false};
        tab-policy: native;
        dismiss(reason) => { if (root.page == ViewPage.detail && root.connected) { root.go-back(); } }
        Rectangle {
            private property <bool> owns-chrome: !root.detail-has-header && !root.media-has-data;
            accessible-role: groupbox;
            accessible-label: root.device-cards.length > 0 ? root.device-cards[0].title : root.detail-title;
            width: content.width < 600px ? content.width : max(0px,min(content.width - 48px,480px));
            height: content.width < 600px ? content.height : min(max(0px, content.height - 48px),
                detail-content.preferred-height + detail-banner.preferred-height + detail-refusal.preferred-height + (self.owns-chrome ? 48px : 0px));
            if self.owns-chrome: KitDialogPanel { theme: root.theme; width: parent.width; height: parent.height; }
            TouchArea { }
            x: content.x + (content.width - self.width) / 2; y: content.y + (content.height - self.height) / 2;
            VerticalLayout {
                padding: parent.owns-chrome ? 20px : 0px; spacing: 0px;
                if !root.detail-has-header && !root.media-has-data: detail-back := KitButton {
                    private property <int> focus-request: root.detail-focus-request;
                    changed focus-request => { if (self.focus-request > 0) { self.take-focus(); } }
                    theme: root.theme; text: "Back"; leading-icon: root.theme.icons.chevron-left;
                    disabled: !root.content-interactive || root.detail-has-header; control-size: comfortable;
                    private property <int> route-generation;
                    activation-started => { self.route-generation = root.projection-version; }
                    activated => { if (self.route-generation == root.projection-version && root.page == ViewPage.detail) { root.go-back(); } }
                }
                detail-banner := HomewardConnectionBanner { theme: root.theme; status: root.connection-status; interactive: root.content-interactive; retry => { root.read-protected(); } }
                detail-refusal := VerticalLayout {
                    if root.action-feedback != "": KitAlert {
                        theme: root.theme; title: root.action-feedback; severity: information;
                    }
                }
                detail-scroll := KitScrollArea {
                    pan-policy: children-first;
                    overlay-scrollbars: true;
                    vertical-stretch: 1;
                detail-content := VerticalLayout {
                    min-width: 0px; preferred-width: 0px;
                    spacing: 8px;
                if !root.media-has-data: HomewardDeviceDetail {
                    lock-operation(t,g,operation) => { root.lock-operation(t,g,operation); }
                    alarm-mode(t,g,c) => { root.alarm-mode(t,g,c); }
                    alarm-digit(t,g,d) => { root.alarm-digit(t,g,d); }
                    alarm-clear(t,g) => { root.alarm-clear(t,g); }
                    alarm-confirm(t,g) => { root.alarm-confirm(t,g); }
                    tools: [{token: 1, label: "History and diagnostics", glyph: LucideIcons.rotate-ccw-clock()}];
                    tool-requested(token) => { if (token == 1) { root.show-detail-history = !root.show-detail-history; } }
                    focus-request: root.detail-focus-request;
                    step(t,g,d) => { root.device-step(t,g,d); }
                    theme: root.theme; viewport-width: detail-scroll.visible-width;
                    minimum-panel-height: content.width < 600px ? max(0px, content.height - detail-banner.preferred-height - detail-refusal.preferred-height) : 0px;
                    panels: root.detail-panels;
                    dismiss(reason) => { root.go-back(); }
                    interactive: root.dashboard-interactive && root.page == ViewPage.detail; commands-ready: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    edit(token,generation,field,intent) => { root.device-edit(token,generation,field,intent); }
                    choose(token,generation,choice) => { root.device-choice(token,generation,choice); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                }
                if root.media-visible && (root.media-has-data || root.media-notice != "" || root.show-detail-history): HomewardMedia {
                    width: min(detail-scroll.visible-width,480px);
                    minimum-panel-height: content.width < 600px ? max(0px, content.height - detail-banner.preferred-height - detail-refusal.preferred-height) : 0px;
                    tools: [{token: -1, label: "History and diagnostics", glyph: LucideIcons.rotate-ccw-clock()},
                        {token: root.media-generation, label: "Refresh media", glyph: LucideIcons.refresh-cw()}];
                    tool-requested(token) => { if (token == -1) { root.show-detail-history = !root.show-detail-history; } }
                    theme: root.theme; title: root.detail-title; generation: root.media-generation;
                    dismiss(reason) => { root.go-back(); }
                    interactive: root.media-interactive; suspended: root.cohort-pending || root.media-retention-ms > 0; editable: root.media-editable; has-data: root.media-has-data;
                    media: root.media-data; actions: root.media-actions; options: root.media-options; values: root.media-values;
                    progress-known: root.media-progress-known; progress: root.media-progress;
                    position-label: root.media-position-label; duration-label: root.media-duration-label;
                    group-title: root.media-group-title; coordinator: root.media-coordinator; members: root.media-members;
                    notice: root.media-notice; artwork-remaining-ms: root.media-artwork-remaining-ms;
                    operation(token,generation,operation) => { root.media-operation(token,generation,operation); }
                    option(token,generation,kind,option) => { root.media-option(token,generation,kind,option); }
                    edit(token,generation,field,intent) => { root.media-edit(token,generation,field,intent); }
                    reload(generation) => { root.media-reload(generation); }
                    expire-artwork(generation) => { root.media-expire-artwork(generation); }
                }
                if !root.detail-has-header && !root.media-has-data: KitButton { theme: root.theme; text: root.show-detail-history ? "Hide History and Diagnostics" : "History and Diagnostics"; disabled: !root.content-interactive; activated => { root.show-detail-history = !root.show-detail-history; } }
                if root.show-detail-history: VerticalLayout {
                    spacing: 8px;
                    Text { text: root.detail-quality + " · " + root.detail-date; color: root.theme.text-secondary; font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
                HomewardHistory {
                    theme: root.theme; interactive: root.dashboard-interactive && root.view-loaded && root.page == ViewPage.detail; suspended: root.cohort-pending || root.history-revalidating;
                    presentation: root.history-presentation;
                    start <=> root.history-start; end <=> root.history-end; statistic <=> root.history-statistic;
                    apply(start,end,stat) => { root.history-apply(start,end,stat); }
                    draft-changed => { root.history-draft-changed(); }
                    choose-statistic(stat) => { root.history-choose-statistic(stat); }
                    group(step) => { root.history-group(step); }
                    inspect(g,x) => { root.history-inspect(g,x); }
                    navigate(g,step,extend) => { root.history-navigate(g,step,extend); }
                    interval(g,gesture,x) => { root.history-interval(g,gesture,x); }
                    viewport(w,h,bg,accent) => { root.history-viewport(w,h,bg,accent); }
                }
                }
                }
            }
        }
    }
    }
    popup-dialog := HomewardPopup {
        safe-area-insets: root.safe-area-insets;
                    step(t,g,d) => { root.device-step(t,g,d); }
        width: root.width; height: root.height; theme: root.theme;
        state: { open: root.native-popup.open, topmost: root.native-popup.topmost && !root.recipe-confirmation.open, busy: root.native-popup.busy };
        generation: root.native-popup-generation; title: root.native-popup-title;
        detail: root.native-popup-detail; can-back: root.native-popup-can-back;
        back(generation) => { root.native-popup-back(generation); }
        nodes: root.popup-layout-nodes; commands-enabled: root.commands-ready;
        action-feedback: root.action-feedback;
        recipe-focus: root.recipe-focus; tile-focus: root.tile-focus;
                    tile-focus-revealed(t,g,top,bottom) => { if (root.tile-focus.present && root.tile-focus.token == t && root.tile-focus.generation == g && !root.cohort-pending) { root.reveal-recipe(top,bottom); } }
                    widget-focus: root.widget-focus; widget-item-focus: root.widget-item-focus;
                    widget-activate(t,g) => { root.dashboard-widget-activate(t,g); }
                    task-complete(t,g,i,ig,v) => { if (root.commands-ready) { root.dashboard-task-complete(t,g,i,ig,v); } }
                    agenda-select(t,g,i,ig) => { root.dashboard-agenda-select(t,g,i,ig); }
                    observation-open(t,g,i,ig) => { root.dashboard-observation-open(t,g,i,ig); }
                    observation-focus-observed(t,g,i,ig,f) => { root.dashboard-observation-focus(t,g,i,ig,f); }
                    widget-focus-observed(t,g,f) => { root.dashboard-widget-focus(t,g,f); }
                    widget-focus-applied(t,g,r) => { root.dashboard-widget-focus-applied(t,g,r); }
                    widget-focus-revealed(t,g,top,bottom) => { root.dashboard-widget-focus-revealed(t,g,top,bottom); }

        recipe-focus-applied(token,generation,serial) => { root.recipe-focus-applied(token,generation,serial); }
        recipe-focus-observed(token,generation,focused) => { root.recipe-focus-observed(token,generation,focused); }
        recipe-focus-revealed(token,generation,top,bottom) => { root.recipe-focus-revealed(token,generation,top,bottom); }
        scroll-interacted => { root.native-focus-cancelled(); }
        close(generation,reason) => { root.native-popup-dismiss(generation,reason); }
        power(token,generation,intent) => { root.device-power(token,generation,intent); }
        edit(token,generation,field,intent) => { root.device-edit(token,generation,field,intent); }
        choose(token,generation,choice) => { root.device-choice(token,generation,choice); }
        brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
        stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
        details(token,generation) => { root.device-details(token,generation); }
        gesture(token,generation,gesture) => { root.recipe-gesture(token,generation,gesture); }
    }
    HomewardConfirmation {
        width: root.width; height: root.height;
        theme: root.theme; state: root.recipe-confirmation;
        confirmation-id: root.recipe-confirmation-id;
        title: root.recipe-confirmation-title; message: root.recipe-confirmation-message;
        action-description: root.recipe-confirmation-description;
        confirm(id) => { root.recipe-confirm(id); }
        dismiss(reason) => { root.recipe-dismiss(root.recipe-confirmation-id, reason); }
    }
}
