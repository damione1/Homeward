    public function clear-invitation() {
        root.invitation-visible = false; root.invitation-busy = false; root.invitation-uncertain = false;
        root.invitation-token-draft = ""; root.invitation-password-draft = ""; root.invitation-name-draft = ""; root.invitation-feedback = "";
        if (root.invitation-generation < 2147483647) { root.invitation-generation += 1; }
        root.invitation-closed();
    }
    changed show-endpoint => { if (root.show-endpoint) { root.clear-invitation(); } }
    changed access-stage => { if (root.access-stage != ProAccessStage.identity) { root.clear-invitation(); } }
