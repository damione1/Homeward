import { KitButton, KitTheme, KitThemes, KitCard, KitCardHeader, KitUrlField,
    KitTextArea, KitScrollArea, KitStack, KitWrap, KitAlert, AlertSeverity, ControlWidth,
    KitDataTable, TableRow, DataSortDirection, DataAlignment, NavigationStep,
    KitMetrics, ControlSize, OptionRow, SelectState, DialogState, CloseReason, FocusRequest, IconKind } from "@kit/kit.slint";
import { ProAccessPanel, ProAccessStage, ProAdaptiveShell, ProShellFocus, ProHomeOverview, ProRoomRow, ProObservationRow, ProDeviceRow, ProPowerIntent } from "@kit-pro/kit-pro.slint";
import { HomewardSkin } from "skin.slint";
import { HomewardDevices } from "device-cards.slint";

export enum ViewPage { home, rooms, inventory, room, detail, settings }
export enum RoomView { cards, list }
export enum BodyFocus { read, inventory, back, settings }

export component HomewardWindow inherits Window {
    title: "Homeward · Développement";
    preferred-width: 1280px; preferred-height: 800px;
    min-width: 320px; min-height: 400px;
    background: root.theme.canvas;
    in-out property <bool> dark-mode;
    in property <KitTheme> theme: HomewardSkin.theme(root.dark-mode, root.opaque-surfaces, max(root.large-text ? 2 : 1, root.default-font-size / 14px), root.reduced-motion);
    in-out property <string> server-draft;
    in-out property <string> certificate-draft;
    in-out property <bool> show-endpoint: true;
    in property <bool> endpoint-ready;
    in property <string> endpoint-label;
    in property <string> trust-fingerprint;
    in property <string> setup-message;
    in-out property <ProAccessStage> access-stage: ProAccessStage.identity;
    in property <bool> busy;
    in property <bool> can-recover;
    in property <string> message-title;
    in property <string> message;
    in property <AlertSeverity> message-severity: AlertSeverity.information;
    in property <string> read-status;
    in property <string> cache-error;
    in property <[TableRow]> cache-rows;
    in-out property <int> cache-active-index: -1;
    private property <length> cache-row-height: KitMetrics.control-height(ControlSize.medium, root.theme.text-scale) + 8px;
    in property <string> session-title;
    in property <string> session-description;
    in property <AlertSeverity> session-severity: AlertSeverity.success;
    in-out property <string> user-draft;
    in-out property <string> password-draft;
    in-out property <string> recovery-draft;
    callback connect-endpoint(string, string);
    callback sign-in(string, string);
    callback verify-recovery(string);
    callback sign-out();
    callback cancel-access();
    callback read-protected();
    callback cache-viewport(int,int);
    callback cache-navigate(NavigationStep);


    in-out property <bool> opaque-surfaces: true;
    in-out property <bool> large-text;
    in-out property <bool> reduced-motion: true;
    in property <ViewPage> page: ViewPage.home;
    in property <string> page-title: "Accueil";
    in property <string> dashboard-title: "Accueil";
    in property <string> dashboard-status;
    in property <bool> dashboard-synthetic;
    in property <string> local-clock;
    in property <string> local-date;
    in property <[OptionRow]> navigation-rows;
    in property <SelectState> navigation-state;
    in property <DialogState> navigation-drawer;
    in-out property <string> search-query;
    in property <[ProRoomRow]> home-rooms;
    in property <[ProObservationRow]> home-observations;
    in property <[ProDeviceRow]> device-cards;
    in property <bool> commands-ready;
    in property <string> action-feedback;
    in-out property <RoomView> room-view: RoomView.cards;
    changed projection-version => { root.room-view = RoomView.cards; }
    callback device-power(int,int,ProPowerIntent);
    callback device-brightness(int,int,float);
    callback device-stop-tracking(int,int);
    callback device-details(int,int);
    in property <FocusRequest> home-focus;
    in property <int> projection-version;
    in property <int> cache-generation;
    in property <int> home-generation;
    in property <bool> view-loaded;
    in property <string> detail-title;
    in property <string> detail-value;
    in property <string> detail-quality;
    in property <string> detail-date;
    in property <string> preferences-status;
    private property <bool> connected: root.access-stage == ProAccessStage.connected;
    callback private-view-cleared(bool);
    callback dashboard-changed();
    callback navigation-open();
    callback navigation-reopen();
    callback navigation-dismiss(CloseReason);
    callback navigation-activate(int,int);
    callback navigation-step(NavigationStep);
    callback navigation-typeahead(string);
    callback modal-next(bool);
    callback shell-observed(ProShellFocus,bool);
    callback shell-restore();
    callback shell-compact(bool);
    callback query-edited(string);
    callback room-open(int,int);
    callback observation-open(int,int);
    callback home-observed(int,int,bool);
    callback cache-activate(int,int);
    callback go-back();
    callback show-inventory();
    callback choose-room();
    callback preferences-changed(bool,bool,bool,bool);
    callback system-back() -> bool;
    callback content-focus();
    public function take-shell-focus(target: ProShellFocus) { if (root.connected && !root.show-endpoint) { shell.take-focus(target); } }
    public function take-body-focus(target: BodyFocus) {
        if (!root.connected || root.show-endpoint) { return; }
        if (target == BodyFocus.read) { if (!root.view-loaded) { read-button.take-focus(); } else { shell.take-focus(ProShellFocus.workspace); } }
        else if (target == BodyFocus.inventory) { table.take-focus(); }
        else if (target == BodyFocus.back) { if (root.page == ViewPage.detail) { detail-back.take-focus(); } else if (root.page == ViewPage.room && root.room-view == RoomView.cards) { room-back.take-focus(); } else { back-button.take-focus(); } }
        else if (target == BodyFocus.settings) { theme-button.take-focus(); }
    }
    public function reset-list() { root.cache-active-index = 0; table.reveal-active(); }
    function preferences-edited() { root.preferences-changed(root.dark-mode, root.opaque-surfaces, root.large-text, root.reduced-motion); }

    content := FocusScope {
    x: root.safe-area-insets.left; y: root.safe-area-insets.top;
    width: max(0px, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
    height: max(0px, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
    focus-on-tab-navigation: false;
    key-pressed(event) => {
        if (event.text == Key.Back && root.system-back()) { return accept; }
        return reject;
    }
    if !root.connected || root.show-endpoint: KitScrollArea {
        width: content.width; height: content.height;
        inset: roomy; gap: roomy;
        Text { text: "Homeward"; color: root.theme.text-primary; font-size: 30px * root.theme.text-scale; font-weight: 700; wrap: word-wrap; }
        if root.show-endpoint: KitCard {
            theme: root.theme;
            KitCardHeader { theme: root.theme; title: "Votre serveur";
                description: "Adresse HTTPS et certificat public de confiance fourni par votre administrateur."; }
            KitUrlField { theme: root.theme; control-size: comfortable; label: "Adresse du serveur";
                placeholder: "https://home.example.com"; text <=> root.server-draft; }
            KitTextArea { theme: root.theme; control-size: comfortable; label: "Certificat de confiance (PEM)";
                min-lines: 3; max-lines: 5; text <=> root.certificate-draft;
                input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false }; }
            if root.setup-message != "": KitAlert {
                theme: root.theme; title: "Connexion au serveur"; message: root.setup-message;
            }
            KitButton { theme: root.theme; control-size: comfortable; text: "Utiliser ce serveur"; control-width: ControlWidth.fill;
                disabled: root.server-draft == "" || root.certificate-draft == "";
                activated => { root.connect-endpoint(root.server-draft, root.certificate-draft); } }
        }
        if root.endpoint-ready && !root.show-endpoint: KitStack {
            Text { text: root.endpoint-label; color: root.theme.text-secondary;
                font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
            Text { text: "Confiance SHA-256 : " + root.trust-fingerprint; color: root.theme.text-secondary;
                font-size: 12px * root.theme.text-scale; wrap: word-wrap; }
            ProAccessPanel {
                theme: root.theme; control-size: ControlSize.comfortable; stage: root.access-stage; title: "Bienvenue chez vous";
                description: "Connectez-vous à votre installation.";
                user-label: "Identifiant"; password-label: "Mot de passe"; submit-label: "Se connecter";
                verification-title: "Vérification supplémentaire";
                verification-help: "Ce compte demande un second facteur. Les clés FIDO2 ne sont pas encore prises en charge sur ce client.";
                factor-label: "Clé de sécurité · non prise en charge";
                recovery-choice-label: "Utiliser un code de secours";
                recovery-label: "Code de secours"; recovery-submit-label: "Vérifier le code";
                enrollment-title: "Enrôlement requis";
                enrollment-help: "Une clé doit être enregistrée avant de poursuivre. Utilisez un client disposant d’un provider FIDO2 qualifié, puis recommencez la connexion ici.";
                enroll-label: "Enrôlement indisponible sur ce client";
                connected-title: root.session-title;
                connected-description: root.session-description;
                connected-severity: root.session-severity;
                sign-out-label: "Se déconnecter"; restart-label: "Recommencer";
                show-label: "Afficher"; hide-label: "Masquer"; cancel-label: "Annuler";
                busy-label: "Connexion en cours…"; busy: root.busy; can-recover: root.can-recover;
                message-title: root.message-title; message: root.message; message-severity: root.message-severity;
                user-draft <=> root.user-draft; password-draft <=> root.password-draft; recovery-draft <=> root.recovery-draft;
                sign-in(user, password) => { root.sign-in(user, password); }
                choose-recovery => { root.access-stage = ProAccessStage.recovery; }
                verify-recovery(code) => { root.verify-recovery(code); }
                restart => { root.cancel-access(); }
                cancel => { root.cancel-access(); }
                sign-out => { root.sign-out(); }
            }
            KitButton { theme: root.theme; control-size: comfortable; text: "Changer de serveur";
                activated => { root.password-draft = ""; root.recovery-draft = ""; root.show-endpoint = true; } }
        }

    }
    shell := ProAdaptiveShell {
        width: content.width; height: content.height;
        visible: root.connected && !root.show-endpoint;
        theme: root.theme; product-name: "Homeward"; workspace-label: root.dashboard-title;
        compact-breakpoint: 1100px;
        page-title: root.page == ViewPage.home ? root.dashboard-title + " · " + root.local-clock : root.page-title;
        status: root.read-status == "" ? root.session-title : root.read-status;
        navigation-label: "Navigation"; close-label: "Fermer la navigation";
        search-label: "Rechercher dans ma maison"; search-placeholder: "Rechercher un élément…"; clear-search-label: "Effacer la recherche";
        query <=> root.search-query;
        navigation-rows: root.navigation-rows; navigation-state: root.navigation-state; drawer-state: root.navigation-drawer;
        navigation-open => { root.navigation-open(); }
        navigation-dismiss(reason) => { root.navigation-dismiss(reason); }
        navigation-activate(token,generation) => { root.navigation-activate(token,generation); }
        navigation-step(step) => { root.navigation-step(step); }
        navigation-typeahead(text) => { root.navigation-typeahead(text); }
        query-edited(text) => { root.query-edited(text); }
        workspace-requested => { root.choose-room(); }
        focus-next(reverse) => { root.modal-next(reverse); }
        focus-observed(target,focused) => { root.shell-observed(target,focused); }
        restore-focus => { root.shell-restore(); }
        compact-changed(compact) => { root.shell-compact(compact); }
        content-focus-requested => { root.content-focus(); }
        viewport := Rectangle {
            min-width: 0px; min-height: 0px; max-width: 100000px; max-height: 100000px;
            horizontal-stretch: 1; vertical-stretch: 1;
            home := KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.home;
                gap: root.view-loaded && root.dashboard-status == "" ? none : roomy;
                Rectangle {
                    height: root.view-loaded && root.dashboard-status == "" ? 0px : read-button.preferred-height;
                    visible: !root.view-loaded || root.dashboard-status != "";
                    read-button := KitButton { x: 0px; y: 0px; width: min(parent.width, 250px * root.theme.text-scale);
                        theme: root.theme; control-size: comfortable; control-width: ControlWidth.fill; disabled: root.busy;
                        text: "Afficher ma maison"; busy: root.busy; activated => { root.read-protected(); } }
                }
                if root.dashboard-synthetic: KitAlert { theme: root.theme; title: "Serveur de test"; message: "Données synthétiques · aucun appareil réel"; severity: information; }
                if root.dashboard-status != "": KitAlert { theme: root.theme; title: "Dashboard"; message: root.dashboard-status; severity: information; }
                if root.device-cards.length > 0: Text { text: "En un regard"; color: root.theme.text-primary; font-size: 20px * root.theme.text-scale; font-weight: 600; }
                if root.device-cards.length > 0: HomewardDevices {
                    theme: root.theme; viewport-width: viewport.width; devices: root.device-cards;
                    interactive: root.connected && root.page == ViewPage.home; commands-ready: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                    details(token,generation) => { root.device-details(token,generation); }
                }
                if root.action-feedback != "": KitAlert { theme: root.theme; title: "Commande"; message: root.action-feedback; severity: information; }
                ProHomeOverview {
                    theme: root.theme; viewport-width: viewport.width; spacing: 12px;
                    observations-title: root.device-cards.length == 0 ? "En un regard" : "Autres observations"; rooms-title: "Vos pièces";
                    observations: root.home-observations;
                    rooms: root.home-rooms;
                    interactive: root.connected && root.page == ViewPage.home;
                    focus-request: root.home-focus;
                    room-open(token,generation) => { root.room-open(token,generation); }
                    observation-open(token,generation) => { root.observation-open(token,generation); }
                    room-focus-observed(token,generation,focused) => { root.home-observed(token,generation,focused); }
                    observation-focus-observed(token,generation,focused) => { root.home-observed(token,generation,focused); }
                }
                if root.cache-error != "": KitAlert { theme: root.theme; title: "Dernière lecture"; message: root.cache-error; severity: warning; }
            }
            KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.rooms;
                ProHomeOverview {
                    theme: root.theme; viewport-width: viewport.width; spacing: 12px;
                    rooms-title: "Choisissez une pièce"; rooms: root.home-rooms;
                    interactive: root.connected && root.page == ViewPage.rooms;
                    focus-request: root.home-focus;
                    room-open(token,generation) => { root.room-open(token,generation); }
                    room-focus-observed(token,generation,focused) => { root.home-observed(token,generation,focused); }
                }
            }
            KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.room && root.room-view == RoomView.cards;
                room-back := KitButton { theme: root.theme; text: "Retour"; control-size: comfortable; activated => { root.go-back(); } }
                Text { text: "Commandes et observations autorisées"; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                if root.device-cards.length == 0: Text { text: "Aucune carte disponible pour les fonctions de cette pièce. La liste complète reste accessible."; color: root.theme.text-secondary; font-size: 16px * root.theme.text-scale; wrap: word-wrap; }
                if root.action-feedback != "": KitAlert { theme: root.theme; title: "Commande"; message: root.action-feedback; severity: information; }
                HomewardDevices {
                    theme: root.theme; viewport-width: viewport.width; devices: root.device-cards;
                    interactive: root.connected && root.page == ViewPage.room && root.room-view == RoomView.cards; commands-ready: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                    details(token,generation) => { root.device-details(token,generation); }
                }
                KitButton { theme: root.theme; text: "Liste complète des éléments"; control-size: comfortable; activated => { root.room-view = RoomView.list; root.content-focus(); } }
            }
            inventory := Rectangle {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.inventory || (root.page == ViewPage.room && root.room-view == RoomView.list);
                VerticalLayout {
                    spacing: 12px;
                    back-button := KitButton { theme: root.theme; control-size: comfortable; text: "Retour"; activated => { if (root.page == ViewPage.room) { root.room-view = RoomView.cards; root.content-focus(); } else { root.go-back(); } } }
                    Text { visible: root.cache-rows.length == 0; text: root.search-query == "" ? "Aucune observation associée. Affichez votre maison pour charger les états autorisés." : "Aucun résultat pour cette recherche.";
                        color: root.theme.text-secondary; font-size: 16px * root.theme.text-scale; wrap: word-wrap; }
                    table := KitDataTable {
                        theme: root.theme; control-size: comfortable; label: "États de l’installation";
                        rows: root.cache-rows; active-index: root.cache-active-index; generation: root.cache-generation;
                        vertical-stretch: 1;
                        columns: [
                            { token: 0, label: "Élément", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading },
                            { token: 1, label: "État", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading },
                            { token: 2, label: "Qualité", sortable: false, sort: DataSortDirection.unsorted, alignment: DataAlignment.leading }
                        ];
                        private property <length> projected-row-height: KitMetrics.control-height(ControlSize.comfortable, root.theme.text-scale) + 8px;
                        private property <int> first-visible: max(0, floor(-self.scroll-y / self.projected-row-height));
                        private property <int> visible-count: min(64, ceil(self.height / self.projected-row-height) + 16);
                        init => { root.cache-viewport(self.first-visible, self.visible-count); }
                        changed first-visible => { root.cache-viewport(self.first-visible, self.visible-count); }
                        changed visible-count => { root.cache-viewport(self.first-visible, self.visible-count); }
                        navigate(step) => { root.cache-navigate(step); }
                        activate(token,generation) => { root.cache-activate(token,generation); }
                    }
                }
            }
            KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.detail;
                detail-back := KitButton { theme: root.theme; control-size: comfortable; text: "Retour aux éléments"; activated => { root.go-back(); } }
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: root.detail-title; description: "Observation reçue · consultation"; }
                    Text { text: root.detail-value; color: root.theme.text-primary; font-size: 26px * root.theme.text-scale; wrap: word-wrap; }
                    Text { text: root.detail-quality; color: root.theme.text-secondary; font-size: 16px * root.theme.text-scale; wrap: word-wrap; }
                    Text { text: root.detail-date; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                }
                if root.action-feedback != "": KitAlert { theme: root.theme; title: "Commande"; message: root.action-feedback; severity: information; }
                HomewardDevices {
                    theme: root.theme; viewport-width: viewport.width; devices: root.device-cards; show-details: false;
                    interactive: root.connected && root.page == ViewPage.detail; commands-ready: root.commands-ready;
                    power(token,generation,intent) => { root.device-power(token,generation,intent); }
                    brightness(token,generation,value) => { root.device-brightness(token,generation,value); }
                    stop-tracking(token,generation) => { root.device-stop-tracking(token,generation); }
                }
            }
            KitScrollArea {
                x: 0px; y: 0px; width: viewport.width; height: viewport.height;
                visible: root.page == ViewPage.settings;
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: "À votre mesure"; description: "Préférences de cet appareil"; }
                    KitWrap {
                        theme-button := KitButton { theme: root.theme; control-size: comfortable; text: root.dark-mode ? "Thème clair" : "Thème sombre"; activated => { root.dark-mode = !root.dark-mode; root.preferences-edited(); } }
                        KitButton { theme: root.theme; control-size: comfortable; text: root.opaque-surfaces ? "Surfaces translucides" : "Surfaces opaques"; activated => { root.opaque-surfaces = !root.opaque-surfaces; root.preferences-edited(); } }
                        KitButton { theme: root.theme; control-size: comfortable; text: root.large-text ? "Texte standard" : "Texte à 200 %"; activated => { root.large-text = !root.large-text; root.preferences-edited(); } }
                        KitButton { theme: root.theme; control-size: comfortable; text: root.reduced-motion ? "Autoriser les animations" : "Réduire les animations"; activated => { root.reduced-motion = !root.reduced-motion; root.preferences-edited(); } }
                    }
                    Text { text: root.preferences-status; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                }
                KitCard { theme: root.theme;
                    KitCardHeader { theme: root.theme; title: root.session-title; description: root.session-description; }
                    Text { text: root.endpoint-label; color: root.theme.text-secondary; font-size: 14px * root.theme.text-scale; wrap: word-wrap; }
                    KitWrap {
                        KitButton { theme: root.theme; control-size: comfortable; text: "Se déconnecter"; activated => { root.sign-out(); } }
                        KitButton { theme: root.theme; control-size: comfortable; text: "Changer de serveur"; activated => { root.cancel-access(); root.show-endpoint = true; } }
                    }
                }
            }
        }
    }
}
}
