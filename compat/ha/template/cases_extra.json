{
  "variables": {
    "value_json": {
      "state": "on",
      "battery": 0,
      "energy": 12.5,
      "illuminance": 1,
      "occupancy": false,
      "power": 0,
      "water_leak": null
    }
  },
  "cases": [
    {"id":"nha043-01-missing-state","template":"{{ states('sensor.nha_missing') }}"},
    {"id":"nha043-02-missing-attribute","template":"{{ state_attr('sensor.nha_missing','target') }}"},
    {"id":"nha043-03-as-datetime-date","template":"{{ as_datetime('2024-03-09').date() }}"},
    {"id":"nha043-04-date-days","template":"{{ (now().date() - as_datetime('2024-03-09').date()).days }}"},
    {"id":"nha043-05-dst-days","template":"{{ (as_datetime('2024-03-10').date() - as_datetime('2024-03-09').date()).days }}"},
    {"id":"nha043-06-now","template":"{{ now() }}"},
    {"id":"nha043-07-as-datetime","template":"{{ as_datetime('2024-03-09') }}"},
    {"id":"nha043-08-json-dot","template":"{{ value_json.state }}"},
    {"id":"nha043-09-json-battery","template":"{{ value_json[\"battery\"] }}"},
    {"id":"nha043-10-json-energy","template":"{{ value_json[\"energy\"] }}"},
    {"id":"nha043-11-json-illuminance","template":"{{ value_json[\"illuminance\"] }}"},
    {"id":"nha043-12-json-occupancy","template":"{{ value_json[\"occupancy\"] }}"},
    {"id":"nha043-13-json-power","template":"{{ value_json[\"power\"] }}"},
    {"id":"nha043-14-json-state","template":"{{ value_json[\"state\"] }}"},
    {"id":"nha043-15-json-water-leak","template":"{{ value_json[\"water_leak\"] }}"},
    {"id":"nha043-16-trim-expression","template":"  {{ 1 }}  "},
    {"id":"nha043-17-trim-static","template":"  hi  "},
    {"id":"nha043-18-quoted-scalar","template":"{{ \"'hello'\" }}"},
    {"id":"nha043-19-dot-five","template":"{{ '.5' }}"},
    {"id":"nha043-20-scientific-text","template":"{{ '1e3' }}"},
    {"id":"nha043-21-leading-zero","template":"{{ '001' }}"},
    {"id":"nha043-22-bool-float","template":"{{ true | float(0) }}"},
    {"id":"nha043-23-small-float","template":"{{ 0.0000001 }}"},
    {"id":"nha043-24-large-float","template":"{{ 100000000000000000000.0 }}"},
    {"id":"nha043-25-list-quote","template":"{{ [\"a'b\", \"c\\\\d\"] }}"},
    {"id":"nha043-26-list-numeric","template":"{{ [1.2, 2] }}"},
    {"id":"nha043-27-list-from-text","template":"{{ '[1, 2]' }}"},
    {"id":"nha043-28-negative-duration","template":"{{ (as_datetime('2024-03-09').date() - as_datetime('2024-03-10').date()) }}"},
    {"id":"nha043-29-zero-duration","template":"{{ (as_datetime('2024-03-09').date() - as_datetime('2024-03-09').date()) }}"},
    {"id":"nha043-30-microseconds","template":"{{ as_datetime('2024-03-09T12:34:56.123456+00:00') }}"},
    {"id":"nha043-31-mixed-list","template":"{{ [true, none, 0, 0.0] }}"},
    {"id":"nha043-32-million-float","template":"{{ 1000000.0 }}"},
    {"id":"nha043-33-quadrillion-float","template":"{{ 1000000000000000.0 }}"},
    {"id":"nha043-34-exponent-threshold","template":"{{ 10000000000000000.0 }}"},
    {"id":"nha043-35-small-decimal-threshold","template":"{{ 0.0001 }}"},
    {"id":"nha043-36-small-exponent-threshold","template":"{{ 0.00001 }}"},
    {"id":"nha043-37-smaller-exponent","template":"{{ 0.000001 }}"},
    {"id":"nha043-38-scientific-list","template":"{{ [100000000000000000000.0] }}"},
    {"id":"nha043-39-dst-spring","template":"{{ (as_datetime('2024-03-11T00:00:00-04:00').date() - as_datetime('2024-03-10T00:00:00-05:00').date()).days }}"},
    {"id":"nha043-40-dst-fall","template":"{{ (as_datetime('2024-11-04T00:00:00-05:00').date() - as_datetime('2024-11-03T00:00:00-04:00').date()).days }}"},
    {"id":"nha043-41-list-u0080","template":"{{ ['\u0080'] }}"},
    {"id":"nha043-42-list-u00a0","template":"{{ ['\u00a0'] }}"},
    {"id":"nha043-43-list-u2028","template":"{{ ['\u2028'] }}"}
  ]
}
